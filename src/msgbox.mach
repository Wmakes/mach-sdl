# native message boxes (sdl.msgbox)
#
# one-shot dialogs through the OS's own UI (Win32 MessageBox, NSAlert, GTK).
# useful for fatal errors or a confirmation where a terminal message would be
# missed. blocks until the user clicks OK.

use sdl.c;
use sdl.error;
use sdl.window.Window;
use std.types.error.err;
use std.types.string.str;

# what kind of dialog to show
# ---
# info:  informational
# warn:  warning
# error: error
pub tag Kind: u8 {
    info;
    warn;
    error;
}

# turn an SDL bool result into err[error.Error]
# ---
# succeeded: the u8 result of an SDL call, nonzero on success
fun to_err(succeeded: u8) err[error.Error] {
    if (succeeded == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# show a message box with a title, a message and an OK button
# ---
# kind:    the kind of dialog
# title:   dialog title
# message: body text
# win:     parent window; pass an invalid Window (nil handle) for a
#          parentless box, e.g. when init failed before any window existed
# ret:     ok, or error.Error.failed if the platform could not show a dialog
#          (text from error.message())
pub fun show(kind: Kind, title: str, message: str, win: Window) err[error.Error] {
    var flags: u32 = c.MESSAGEBOX_INFORMATION;
    if (sel kind.warn)  { flags = c.MESSAGEBOX_WARNING; }
    if (sel kind.error) { flags = c.MESSAGEBOX_ERROR; }
    ret to_err(c.SDL_ShowSimpleMessageBox(flags, title, message, win.handle));
}
