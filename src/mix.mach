# raw C-ABI imports of SDL3_mixer 3.2
#
# every function is a pub ext fun with its C name and C-faithful types,
# transcribed from SDL3_mixer's SDL_mixer.h (release-3.2.4). it lives apart
# from sdl.c because SDL3_mixer is a separate shared library (libSDL3_mixer)
# with its own link entry in mach.toml, bound as library "sdl-mixer".
#
# conventions match sdl.c: SDL's `bool` is a 1-byte C99 _Bool, so every
# bool-returning or bool-taking function is declared u8. opaque handles
# (MIX_Mixer *, MIX_Audio *, MIX_Track *, MIX_Group *, MIX_AudioDecoder *,
# SDL_AudioStream *, SDL_IOStream *) are held as ptr. `const char *` is *u8.
# `size_t` is usize. `int` is i32. `Sint64` is i64. `float` is f32.
# SDL_PropertiesID and SDL_AudioDeviceID are u32.
#
# MIX_StereoGains and MIX_Point3D are the only concrete structs. both are
# only ever passed by pointer, never by value across an ext fun boundary.
# layout tests verify the sizes the C compiler produces.
#
# callbacks (MIX_TrackStoppedCallback, MIX_TrackMixCallback,
# MIX_GroupMixCallback, MIX_PostMixCallback): the parameter is typed ptr
# because no function in this project uses callback-driven mixing; sdl.mixer
# always passes nil for these. the same rationale applies to
# SDL_OpenAudioDeviceStream's callback parameter in sdl.c.
#
# function count: 94. a regex that matches any identifier starting with
# `MIX_` also catches 5 type names in the header (MIX_Mixer, MIX_Audio,
# MIX_Track, MIX_Group, MIX_AudioDecoder), giving a naive count of 99.
#
# version compatibility: 3.2.0, 3.2.2 and 3.2.4 export the identical 94
# functions. PROP_PLAY_START_ORDER_NUMBER was added in 3.2.2 and
# PROP_AUDIO_LOAD_IGNORE_LOOPS_BOOLEAN in 3.2.4; an unknown property name
# is silently ignored by SDL, so both constants are safe to pass to any
# 3.2.x library. the installed version at binding time is 3.2.4.

use sdl.c;
use std.types.size.usize;
use std.types.string.str;

# MIX_StereoGains, transcribed field-for-field from SDL_mixer.h. two f32
# fields (left, right): 4+4 = 8 bytes, no padding.
pub rec StereoGains {
    left:  f32;
    right: f32;
}

test mix__stereogains_layout_is_8_bytes {
    if ($size_of(StereoGains) != 8) { ret 1; }
    ret 0;
}

# MIX_Point3D, transcribed field-for-field from SDL_mixer.h. three f32
# fields (x, y, z): 4+4+4 = 12 bytes, no padding.
pub rec Point3D {
    x: f32;
    y: f32;
    z: f32;
}

test mix__point3d_layout_is_12_bytes {
    if ($size_of(Point3D) != 12) { ret 1; }
    ret 0;
}

# --- property name strings ---
#
# passed to SDL_SetNumberProperty / SDL_SetBooleanProperty /
# SDL_SetFloatProperty via sdl.c. values verified against SDL_mixer.h
# release-3.2.4.

# mixer properties
pub val PROP_MIXER_DEVICE_NUMBER: str = "SDL_mixer.mixer.device";

# audio load properties (for MIX_LoadAudioWithProperties)
pub val PROP_AUDIO_LOAD_IOSTREAM_POINTER:          str = "SDL_mixer.audio.load.iostream";
pub val PROP_AUDIO_LOAD_CLOSEIO_BOOLEAN:           str = "SDL_mixer.audio.load.closeio";
pub val PROP_AUDIO_LOAD_PREDECODE_BOOLEAN:         str = "SDL_mixer.audio.load.predecode";
pub val PROP_AUDIO_LOAD_PREFERRED_MIXER_POINTER:   str = "SDL_mixer.audio.load.preferred_mixer";
pub val PROP_AUDIO_LOAD_SKIP_METADATA_TAGS_BOOLEAN: str = "SDL_mixer.audio.load.skip_metadata_tags";
pub val PROP_AUDIO_LOAD_IGNORE_LOOPS_BOOLEAN:      str = "SDL_mixer.audio.load.ignore_loops";
pub val PROP_AUDIO_DECODER_STRING:                 str = "SDL_mixer.audio.decoder";

# audio metadata properties (read from MIX_GetAudioProperties after load)
pub val PROP_METADATA_TITLE_STRING:            str = "SDL_mixer.metadata.title";
pub val PROP_METADATA_ARTIST_STRING:           str = "SDL_mixer.metadata.artist";
pub val PROP_METADATA_ALBUM_STRING:            str = "SDL_mixer.metadata.album";
pub val PROP_METADATA_COPYRIGHT_STRING:        str = "SDL_mixer.metadata.copyright";
pub val PROP_METADATA_TRACK_NUMBER:            str = "SDL_mixer.metadata.track";
pub val PROP_METADATA_TOTAL_TRACKS_NUMBER:     str = "SDL_mixer.metadata.total_tracks";
pub val PROP_METADATA_YEAR_NUMBER:             str = "SDL_mixer.metadata.year";
pub val PROP_METADATA_DURATION_FRAMES_NUMBER:  str = "SDL_mixer.metadata.duration_frames";
pub val PROP_METADATA_DURATION_INFINITE_BOOLEAN: str = "SDL_mixer.metadata.duration_infinite";

# play options (passed to MIX_PlayTrack / MIX_PlayTag via SDL_CreateProperties)
pub val PROP_PLAY_LOOPS_NUMBER:                     str = "SDL_mixer.play.loops";
pub val PROP_PLAY_MAX_FRAME_NUMBER:                 str = "SDL_mixer.play.max_frame";
pub val PROP_PLAY_MAX_MILLISECONDS_NUMBER:          str = "SDL_mixer.play.max_milliseconds";
pub val PROP_PLAY_START_FRAME_NUMBER:               str = "SDL_mixer.play.start_frame";
pub val PROP_PLAY_START_MILLISECOND_NUMBER:         str = "SDL_mixer.play.start_millisecond";
pub val PROP_PLAY_START_ORDER_NUMBER:               str = "SDL_mixer.play.start_order";
pub val PROP_PLAY_LOOP_START_FRAME_NUMBER:          str = "SDL_mixer.play.loop_start_frame";
pub val PROP_PLAY_LOOP_START_MILLISECOND_NUMBER:    str = "SDL_mixer.play.loop_start_millisecond";
pub val PROP_PLAY_FADE_IN_FRAMES_NUMBER:            str = "SDL_mixer.play.fade_in_frames";
pub val PROP_PLAY_FADE_IN_MILLISECONDS_NUMBER:      str = "SDL_mixer.play.fade_in_milliseconds";
pub val PROP_PLAY_FADE_IN_START_GAIN_FLOAT:         str = "SDL_mixer.play.fade_in_start_gain";
pub val PROP_PLAY_APPEND_SILENCE_FRAMES_NUMBER:     str = "SDL_mixer.play.append_silence_frames";
pub val PROP_PLAY_APPEND_SILENCE_MILLISECONDS_NUMBER: str = "SDL_mixer.play.append_silence_milliseconds";
pub val PROP_PLAY_HALT_WHEN_EXHAUSTED_BOOLEAN:      str = "SDL_mixer.play.halt_when_exhausted";

# --- version and lifecycle ---

#[library("sdl-mixer")]
pub ext fun MIX_Version() i32;
#[library("sdl-mixer")]
pub ext fun MIX_Init() u8;
#[library("sdl-mixer")]
pub ext fun MIX_Quit();

