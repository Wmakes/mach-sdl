#[library("sdl-mixer")]
pub ext fun MIX_LoadAudioNoCopy(mixer: ptr, data: ptr, datalen: usize, free_when_done: u8) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_LoadAudioWithProperties(props: u32) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_LoadRawAudio_IO(mixer: ptr, io: ptr, spec: *c.AudioSpec, closeio: u8) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_LoadRawAudio(mixer: ptr, data: ptr, datalen: usize, spec: *c.AudioSpec) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_LoadRawAudioNoCopy(mixer: ptr, data: ptr, datalen: usize, spec: *c.AudioSpec, free_when_done: u8) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_CreateSineWaveAudio(mixer: ptr, hz: i32, amplitude: f32, ms: i64) ptr;

