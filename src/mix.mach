#[library("sdl-mixer")]
pub ext fun MIX_DestroyMixer(mixer: ptr);
#[library("sdl-mixer")]
pub ext fun MIX_GetMixerProperties(mixer: ptr) u32;
#[library("sdl-mixer")]
pub ext fun MIX_GetMixerFormat(mixer: ptr, spec: *c.AudioSpec) u8;
#[library("sdl-mixer")]
pub ext fun MIX_LockMixer(mixer: ptr);
#[library("sdl-mixer")]
pub ext fun MIX_UnlockMixer(mixer: ptr);

