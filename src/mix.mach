# --- track playback position and timing ---
#
# positions and durations are in sample frames. convert with the MIX_*MSToFrames
# and MIX_*FramesToMS helpers. the per-track variants use the track's own
# sample rate; MIX_MSToFrames / MIX_FramesToMS take an explicit sample rate.

#[library("sdl-mixer")]
pub ext fun MIX_SetTrackPlaybackPosition(track: ptr, frames: i64) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackPlaybackPosition(track: ptr) i64;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackFadeFrames(track: ptr) i64;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackLoops(track: ptr) i32;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackLoops(track: ptr, num_loops: i32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackAudio(track: ptr) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackAudioStream(track: ptr) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackRemaining(track: ptr) i64;
#[library("sdl-mixer")]
pub ext fun MIX_TrackMSToFrames(track: ptr, ms: i64) i64;
#[library("sdl-mixer")]
pub ext fun MIX_TrackFramesToMS(track: ptr, frames: i64) i64;
#[library("sdl-mixer")]
pub ext fun MIX_AudioMSToFrames(audio: ptr, ms: i64) i64;
#[library("sdl-mixer")]
pub ext fun MIX_AudioFramesToMS(audio: ptr, frames: i64) i64;
#[library("sdl-mixer")]
pub ext fun MIX_MSToFrames(sample_rate: i32, ms: i64) i64;
#[library("sdl-mixer")]
pub ext fun MIX_FramesToMS(sample_rate: i32, frames: i64) i64;

# --- playback control ---
#
# MIX_StopTrack takes fade_out_frames (sample frames), not milliseconds.
# MIX_StopAllTracks and MIX_StopTag take fade_out_ms (milliseconds). the
# idiomatic layer (sdl.mixer) converts ms to frames for MIX_StopTrack using
# MIX_TrackMSToFrames, and exposes milliseconds uniformly.

#[library("sdl-mixer")]
pub ext fun MIX_PlayTrack(track: ptr, options: u32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_PlayTag(mixer: ptr, tag: *u8, options: u32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_PlayAudio(mixer: ptr, audio: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_StopTrack(track: ptr, fade_out_frames: i64) u8;
#[library("sdl-mixer")]
pub ext fun MIX_StopAllTracks(mixer: ptr, fade_out_ms: i64) u8;
#[library("sdl-mixer")]
pub ext fun MIX_StopTag(mixer: ptr, tag: *u8, fade_out_ms: i64) u8;
#[library("sdl-mixer")]
pub ext fun MIX_PauseTrack(track: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_PauseAllTracks(mixer: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_PauseTag(mixer: ptr, tag: *u8) u8;
#[library("sdl-mixer")]
pub ext fun MIX_ResumeTrack(track: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_ResumeAllTracks(mixer: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_ResumeTag(mixer: ptr, tag: *u8) u8;
#[library("sdl-mixer")]
pub ext fun MIX_TrackPlaying(track: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_TrackPaused(track: ptr) u8;

# --- gain and frequency ---
#
# MIX_GetMixerGain and MIX_GetTrackGain return 1.0f on error.
# MIX_GetTrackFrequencyRatio returns 0.0f on error.
# MIX_GetMixerFrequencyRatio returns 1.0f on error.

#[library("sdl-mixer")]
pub ext fun MIX_SetMixerGain(mixer: ptr, gain: f32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetMixerGain(mixer: ptr) f32;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackGain(track: ptr, gain: f32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackGain(track: ptr) f32;
#[library("sdl-mixer")]
pub ext fun MIX_SetTagGain(mixer: ptr, tag: *u8, gain: f32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetMixerFrequencyRatio(mixer: ptr, ratio: f32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetMixerFrequencyRatio(mixer: ptr) f32;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackFrequencyRatio(track: ptr, ratio: f32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrackFrequencyRatio(track: ptr) f32;

# --- spatial audio ---
#
# MIX_SetTrackStereo clamps negative gains to 0 and resets the track's
# 3D position to (0,0,0). MIX_SetTrack3DPosition and MIX_GetTrack3DPosition
# work in a right-hand coordinate system (negative x = left, positive x =
# right, negative z = forward, positive z = back). the listener is always
# at (0,0,0) and cannot be moved.

#[library("sdl-mixer")]
pub ext fun MIX_SetTrackOutputChannelMap(track: ptr, chmap: *i32, count: i32) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackStereo(track: ptr, gains: *StereoGains) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrack3DPosition(track: ptr, position: *Point3D) u8;
#[library("sdl-mixer")]
pub ext fun MIX_GetTrack3DPosition(track: ptr, position: *Point3D) u8;

# --- group lifecycle ---

#[library("sdl-mixer")]
pub ext fun MIX_CreateGroup(mixer: ptr) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_DestroyGroup(group: ptr);
#[library("sdl-mixer")]
pub ext fun MIX_GetGroupProperties(group: ptr) u32;
#[library("sdl-mixer")]
pub ext fun MIX_GetGroupMixer(group: ptr) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackGroup(track: ptr, group: ptr) u8;

# --- callbacks ---
#
# all callback parameters are typed ptr. sdl.mixer always passes nil for
# both the callback and the userdata pointer: no callback-driven mixing is
# exposed in the idiomatic layer. the same approach is used for
# SDL_OpenAudioDeviceStream in sdl.c.

#[library("sdl-mixer")]
pub ext fun MIX_SetTrackStoppedCallback(track: ptr, cb: ptr, userdata: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackRawCallback(track: ptr, cb: ptr, userdata: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetTrackCookedCallback(track: ptr, cb: ptr, userdata: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetGroupPostMixCallback(group: ptr, cb: ptr, userdata: ptr) u8;
#[library("sdl-mixer")]
pub ext fun MIX_SetPostMixCallback(mixer: ptr, cb: ptr, userdata: ptr) u8;

# --- device-less mixing ---
#
# MIX_Generate always fills the whole buffer, padding with silence. the
# return value is the byte count of real (non-silence) audio mixed; compare
# it separately from buffer energy when testing for silence.

#[library("sdl-mixer")]
pub ext fun MIX_Generate(mixer: ptr, buffer: ptr, buflen: i32) i32;

# --- standalone audio decoder ---

#[library("sdl-mixer")]
pub ext fun MIX_CreateAudioDecoder(path: *u8, props: u32) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_CreateAudioDecoder_IO(io: ptr, closeio: u8, props: u32) ptr;
#[library("sdl-mixer")]
pub ext fun MIX_DestroyAudioDecoder(audiodecoder: ptr);
#[library("sdl-mixer")]
pub ext fun MIX_GetAudioDecoderProperties(audiodecoder: ptr) u32;
#[library("sdl-mixer")]
pub ext fun MIX_GetAudioDecoderFormat(audiodecoder: ptr, spec: *c.AudioSpec) u8;
#[library("sdl-mixer")]
pub ext fun MIX_DecodeAudio(audiodecoder: ptr, buffer: ptr, buflen: i32, spec: *c.AudioSpec) i32;
