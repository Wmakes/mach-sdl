# 2D rendering via SDL's own renderer
#
# an alternative to sdl.gl for simple 2D drawing -- clear/fill-rect/
# present, no GL proc loading, no immediate-mode/core-profile questions.
# use this OR gl.mach for a given window, not both: SDL_CreateRenderer
# and SDL_GL_CreateContext both claim the window's drawable surface.
#
# unlike GL, this genuinely works under the headless dummy video driver
# (SDL picks a software backend), so unlike gl.mach's functions, the
# round-trip here gets a real functional test, not just a demo.

use sdl.c;
use sdl.core;
use sdl.window.Window;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;

# create a renderer for a window
# ---
# window: window to attach the renderer to
# ret:    the renderer handle, or nil on failure -- check core.get_error()
pub fun create_renderer(window: Window) ptr {
    ret c.SDL_CreateRenderer(window.handle, nil);
}

# destroy a renderer
pub fun destroy_renderer(renderer: ptr) {
    c.SDL_DestroyRenderer(renderer);
}

# set the color used by clear/fill/line/point calls until changed again
pub fun set_draw_color(renderer: ptr, r: u8, g: u8, b: u8, a: u8) bool {
    ret c.SDL_SetRenderDrawColor(renderer, r, g, b, a) != 0;
}

# clear the current render target to the current draw color
pub fun clear(renderer: ptr) bool {
    ret c.SDL_RenderClear(renderer) != 0;
}

# fill a rectangle with the current draw color
pub fun fill_rect(renderer: ptr, rect: c.FRect) bool {
    ret c.SDL_RenderFillRect(renderer, ?rect) != 0;
}

# outline a rectangle with the current draw color
pub fun draw_rect(renderer: ptr, rect: c.FRect) bool {
    ret c.SDL_RenderRect(renderer, ?rect) != 0;
}

# draw a line with the current draw color
pub fun draw_line(renderer: ptr, x1: f32, y1: f32, x2: f32, y2: f32) bool {
    ret c.SDL_RenderLine(renderer, x1, y1, x2, y2) != 0;
}

# present everything drawn since the last clear
pub fun present(renderer: ptr) bool {
    ret c.SDL_RenderPresent(renderer) != 0;
}

# load an image file straight into a texture for this renderer -- combines
# SDL_LoadBMP + SDL_CreateTextureFromSurface + SDL_DestroySurface into one
# call, since the intermediate surface has no use once the texture exists.
#
# only BMP is supported (SDL_LoadBMP is all that's bound here) -- other
# formats need SDL_image, a separate library not bound in this project.
# ---
# renderer: renderer to create the texture for
# path:     path to a .bmp file
# ret:      the texture handle, or nil on failure -- check core.get_error()
pub fun load_texture(renderer: ptr, path: str) ptr {
    val surface: ptr = c.SDL_LoadBMP(path);
    if (surface == nil) { ret nil; }

    val texture: ptr = c.SDL_CreateTextureFromSurface(renderer, surface);
    c.SDL_DestroySurface(surface);
    ret texture;
}

# destroy a texture
pub fun destroy_texture(texture: ptr) {
    c.SDL_DestroyTexture(texture);
}

# plain width/height pair, in pixels, as floats (textures report float
# dimensions even though they're pixel-aligned in practice)
pub rec FSize {
    w: f32;
    h: f32;
}

# color triple returned by get_texture_color_mod
pub rec ColorRGB {
    r: u8;
    g: u8;
    b: u8;
}

# a texture's width/height in pixels
# ---
# texture: texture to query
# ret:     (w, h) -- (0.0, 0.0) if the query fails
pub fun texture_size(texture: ptr) FSize {
    var w: f32 = 0.0;
    var h: f32 = 0.0;
    c.SDL_GetTextureSize(texture, ?w, ?h);
    ret FSize{ w: w, h: h };
}

# draw a texture, scaled to fill dst_rect
# ---
# renderer: renderer to draw with
# texture:  texture to draw
# dst_rect: destination rectangle in the renderer's coordinate space --
#           the whole texture is stretched/shrunk to fit it
pub fun draw_texture(renderer: ptr, texture: ptr, dst_rect: c.FRect) bool {
    ret c.SDL_RenderTexture(renderer, texture, nil, ?dst_rect) != 0;
}

# --- blend mode ---

pub val BLEND_NONE:                u32 = c.BLENDMODE_NONE;
pub val BLEND_BLEND:               u32 = c.BLENDMODE_BLEND;
pub val BLEND_BLEND_PREMULTIPLIED: u32 = c.BLENDMODE_BLEND_PREMULTIPLIED;
pub val BLEND_ADD:                 u32 = c.BLENDMODE_ADD;
pub val BLEND_ADD_PREMULTIPLIED:   u32 = c.BLENDMODE_ADD_PREMULTIPLIED;
pub val BLEND_MOD:                 u32 = c.BLENDMODE_MOD;
pub val BLEND_MUL:                 u32 = c.BLENDMODE_MUL;

# set how subsequent draw calls (fill/rect/line/point/texture) combine
# with what's already on the render target -- BLEND_NONE (opaque
# overwrite) until changed
pub fun set_blend_mode(renderer: ptr, blend_mode: u32) bool {
    ret c.SDL_SetRenderDrawBlendMode(renderer, blend_mode) != 0;
}

# --- render target ---
#
# KNOWN GAP: see c.mach's SDL_SetRenderTarget comment -- textures from
# load_texture() are not guaranteed valid render targets, since this
# binding has no lower-level SDL_CreateTexture call that requests
# render-target access. safe today only for restoring the default
# target (pass nil).
# ---
# renderer: renderer to redirect
# texture:  texture to render into, or nil to restore the window itself
pub fun set_render_target(renderer: ptr, texture: ptr) bool {
    ret c.SDL_SetRenderTarget(renderer, texture) != 0;
}

# --- clip rect ---
#
# note the *integer* c.Rect here, not c.FRect like every other rect in
# this module -- SDL's clip-rect calls are integer-only.

# restrict drawing to a sub-region of the render target
pub fun set_clip_rect(renderer: ptr, rect: c.Rect) bool {
    ret c.SDL_SetRenderClipRect(renderer, ?rect) != 0;
}

# remove any clip restriction, drawing to the full target again
pub fun clear_clip_rect(renderer: ptr) bool {
    ret c.SDL_SetRenderClipRect(renderer, nil) != 0;
}

# the renderer's current clip rect
# ---
# ret: the active clip rect; all-zero if there is none set
pub fun get_clip_rect(renderer: ptr) c.Rect {
    var r: c.Rect = c.Rect{ x: 0, y: 0, w: 0, h: 0 };
    c.SDL_GetRenderClipRect(renderer, ?r);
    ret r;
}

# --- render scale ---
#
# scales every subsequent drawing coordinate (fill/rect/line/point/
# texture calls) -- does not affect the window's own pixel size, just
# how renderer-space coordinates map onto it.

pub rec Scale {
    x: f32;
    y: f32;
}

pub fun set_render_scale(renderer: ptr, x: f32, y: f32) bool {
    ret c.SDL_SetRenderScale(renderer, x, y) != 0;
}

pub fun get_render_scale(renderer: ptr) Scale {
    var x: f32 = 0.0;
    var y: f32 = 0.0;
    c.SDL_GetRenderScale(renderer, ?x, ?y);
    ret Scale{ x: x, y: y };
}

# --- bulk draws ---
#
# all three take a pointer to the first element of a c.FPoint (or
# c.FRect) array plus a count -- same "pointer to first element, cast to
# ptr" convention as sdl.audio.put_data's buf param: build the pointer
# with `(?arr[0])::ptr`.

# draw a batch of individual points with the current draw color
pub fun render_points(renderer: ptr, points: ptr, count: i32) bool {
    ret c.SDL_RenderPoints(renderer, points, count) != 0;
}

# draw connected line segments through a batch of points ("connect the
# dots") with the current draw color
pub fun render_lines(renderer: ptr, points: ptr, count: i32) bool {
    ret c.SDL_RenderLines(renderer, points, count) != 0;
}

# fill a batch of rectangles with the current draw color
pub fun fill_rects(renderer: ptr, rects: ptr, count: i32) bool {
    ret c.SDL_RenderFillRects(renderer, rects, count) != 0;
}

# --- texture properties ---
#
# per-texture blend mode, color/alpha modulation, and scale mode --
# independent of the renderer-level draw blend mode.

pub fun set_texture_blend_mode(texture: ptr, blend_mode: u32) bool {
    ret c.SDL_SetTextureBlendMode(texture, blend_mode) != 0;
}

pub fun get_texture_blend_mode(texture: ptr) u32 {
    var mode: u32 = 0;
    c.SDL_GetTextureBlendMode(texture, ?mode);
    ret mode;
}

pub fun set_texture_color_mod(texture: ptr, r: u8, g: u8, b: u8) bool {
    ret c.SDL_SetTextureColorMod(texture, r, g, b) != 0;
}

pub fun get_texture_color_mod(texture: ptr) ColorRGB {
    var r: u8 = 0;
    var g: u8 = 0;
    var b: u8 = 0;
    c.SDL_GetTextureColorMod(texture, ?r, ?g, ?b);
    ret ColorRGB{ r: r, g: g, b: b };
}

pub fun set_texture_alpha_mod(texture: ptr, alpha: u8) bool {
    ret c.SDL_SetTextureAlphaMod(texture, alpha) != 0;
}

pub fun get_texture_alpha_mod(texture: ptr) u8 {
    var alpha: u8 = 0;
    c.SDL_GetTextureAlphaMod(texture, ?alpha);
    ret alpha;
}

# scale mode: SCALEMODE_NEAREST (pixel art) or SCALEMODE_LINEAR (smooth)
pub val SCALEMODE_NEAREST: u32 = c.SCALEMODE_NEAREST;
pub val SCALEMODE_LINEAR:  u32 = c.SCALEMODE_LINEAR;

pub fun set_texture_scale_mode(texture: ptr, scale_mode: u32) bool {
    ret c.SDL_SetTextureScaleMode(texture, scale_mode) != 0;
}

pub fun get_texture_scale_mode(texture: ptr) u32 {
    var mode: u32 = 0;
    c.SDL_GetTextureScaleMode(texture, ?mode);
    ret mode;
}

# --- rotated/flipped texture draw ---
#
# flip flags: FLIP_NONE, FLIP_HORIZONTAL, FLIP_VERTICAL

pub val FLIP_NONE:       u32 = c.FLIP_NONE;
pub val FLIP_HORIZONTAL: u32 = c.FLIP_HORIZONTAL;
pub val FLIP_VERTICAL:   u32 = c.FLIP_VERTICAL;

pub fun draw_texture_rotated(renderer: ptr, texture: ptr, dst_rect: c.FRect, angle: f64, center: c.FPoint, flip: u32) bool {
    ret c.SDL_RenderTextureRotated(renderer, texture, nil, ?dst_rect, angle, ?center, flip) != 0;
}

test "renderer: create/clear/present/destroy round-trip under the dummy driver" {
    if (!core.use_dummy_video_driver()) { ret 1; }
    if (!core.init(core.INIT_VIDEO)) { ret 1; }

    val win: ptr = c.SDL_CreateWindow("renderer test", 64, 64, 0);
    if (win == nil) {
        core.quit();
        ret 1;
    }
    val win_rec: Window = Window{ handle: win };

    val r: ptr = create_renderer(win_rec);
    if (r == nil) {
        c.SDL_DestroyWindow(win);
        core.quit();
        ret 1;
    }

    var ok: bool = set_draw_color(r, 0, 0, 0, 255);
    ok = ok && clear(r);

    val rect: c.FRect = c.FRect{ x: 0.0, y: 0.0, w: 10.0, h: 10.0 };
    ok = ok && fill_rect(r, rect);
    ok = ok && present(r);

    destroy_renderer(r);
    c.SDL_DestroyWindow(win);
    core.quit();

    if (!ok) { ret 1; }
    ret 0;
}

test "renderer: blend mode, clip rect, scale, and bulk draws round-trip under the dummy driver" {
    if (!core.use_dummy_video_driver()) { ret 1; }
    if (!core.init(core.INIT_VIDEO)) { ret 1; }

    val win: ptr = c.SDL_CreateWindow("renderer extras test", 64, 64, 0);
    if (win == nil) {
        core.quit();
        ret 1;
    }
    val win_rec: Window = Window{ handle: win };

    val r: ptr = create_renderer(win_rec);
    if (r == nil) {
        c.SDL_DestroyWindow(win);
        core.quit();
        ret 1;
    }

    var ok: bool = set_blend_mode(r, BLEND_BLEND);

    val clip: c.Rect = c.Rect{ x: 0, y: 0, w: 32, h: 32 };
    ok = ok && set_clip_rect(r, clip);
    ok = ok && clear_clip_rect(r);
    val _unused_clip: c.Rect = get_clip_rect(r);

    ok = ok && set_render_scale(r, 1.0, 1.0);
    val scale: Scale = get_render_scale(r);
    if (scale.x != 1.0 || scale.y != 1.0) { ok = 0; }

    var pts: [3]c.FPoint;
    pts[0] = c.FPoint{ x: 1.0, y: 1.0 };
    pts[1] = c.FPoint{ x: 2.0, y: 2.0 };
    pts[2] = c.FPoint{ x: 3.0, y: 3.0 };
    ok = ok && render_points(r, (?pts[0])::ptr, 3);
    ok = ok && render_lines(r, (?pts[0])::ptr, 3);

    var rects: [2]c.FRect;
    rects[0] = c.FRect{ x: 0.0, y: 0.0, w: 4.0, h: 4.0 };
    rects[1] = c.FRect{ x: 8.0, y: 8.0, w: 4.0, h: 4.0 };
    ok = ok && fill_rects(r, (?rects[0])::ptr, 2);

    ok = ok && set_render_target(r, nil);

    destroy_renderer(r);
    c.SDL_DestroyWindow(win);
    core.quit();

    if (!ok) { ret 1; }
    ret 0;
}

test "renderer: load_texture on a nonexistent file fails cleanly (no crash)" {
    if (!core.use_dummy_video_driver()) { ret 1; }
    if (!core.init(core.INIT_VIDEO)) { ret 1; }

    val win: ptr = c.SDL_CreateWindow("texture test", 64, 64, 0);
    if (win == nil) {
        core.quit();
        ret 1;
    }
    val win_rec: Window = Window{ handle: win };

    val r: ptr = create_renderer(win_rec);
    if (r == nil) {
        c.SDL_DestroyWindow(win);
        core.quit();
        ret 1;
    }

    val tex: ptr = load_texture(r, "this-file-does-not-exist.bmp");

    destroy_renderer(r);
    c.SDL_DestroyWindow(win);
    core.quit();

    if (tex != nil) { ret 1; }  # should have failed, not succeeded
    ret 0;
}

test "renderer: texture blend mode, color/alpha mod, and scale mode round-trip" {
    if (!core.use_dummy_video_driver()) { ret 1; }
    if (!core.init(core.INIT_VIDEO)) { ret 1; }

    val win: ptr = c.SDL_CreateWindow("texture props test", 64, 64, 0);
    if (win == nil) {
        core.quit();
        ret 1;
    }
    val win_rec: Window = Window{ handle: win };

    val r: ptr = create_renderer(win_rec);
    if (r == nil) {
        c.SDL_DestroyWindow(win);
        core.quit();
        ret 1;
    }

    # create a texture to exercise property getters/setters
    val tex: ptr = c.SDL_CreateTexture(r, c.PIXELFORMAT_RGBA8888, c.TEXTUREACCESS_STATIC, 8, 8);
    if (tex == nil) {
        destroy_renderer(r);
        c.SDL_DestroyWindow(win);
        core.quit();
        ret 1;
    }

    var ok: bool = true;

    # blend mode
    ok = ok && set_texture_blend_mode(tex, BLEND_BLEND);
    val blend: u32 = get_texture_blend_mode(tex);
    if (blend != BLEND_BLEND) { ok = false; }

    # color mod
    ok = ok && set_texture_color_mod(tex, 100, 150, 200);
    val rgb: ColorRGB = get_texture_color_mod(tex);
    if (rgb.r != 100 || rgb.g != 150 || rgb.b != 200) { ok = false; }

    # alpha mod
    ok = ok && set_texture_alpha_mod(tex, 128);
    val alpha: u8 = get_texture_alpha_mod(tex);
    if (alpha != 128) { ok = false; }

    # scale mode
    ok = ok && set_texture_scale_mode(tex, SCALEMODE_NEAREST);
    val sm: u32 = get_texture_scale_mode(tex);
    if (sm != SCALEMODE_NEAREST) { ok = false; }

    # draw rotated (no flip, 0 degrees)
    val dst: c.FRect = c.FRect{ x: 0.0, y: 0.0, w: 8.0, h: 8.0 };
    val ctr: c.FPoint = c.FPoint{ x: 4.0, y: 4.0 };
    ok = ok && draw_texture_rotated(r, tex, dst, 0.0, ctr, FLIP_NONE);
    ok = ok && present(r);

    # draw with horizontal flip
    ok = ok && draw_texture_rotated(r, tex, dst, 0.0, ctr, FLIP_HORIZONTAL);

    destroy_texture(tex);
    destroy_renderer(r);
    c.SDL_DestroyWindow(win);
    core.quit();

    if (!ok) { ret 1; }
    ret 0;
}
