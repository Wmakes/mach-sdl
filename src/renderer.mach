# 2D rendering (sdl.renderer)
#
# a Renderer is a by-value handle around SDL_Renderer. every fallible
# function checks its handles first and returns error.Error.invalid for a nil
# one, so SDL is never called with an invalid handle.
#
# use a Renderer or sdl.gl for a given window, not both: SDL_CreateRenderer
# and SDL_GL_CreateContext both claim the window's drawable surface.

use sdl.c;
use sdl.color.Color;
use sdl.error;
use sdl.rect.FPoint;
use sdl.rect.FRect;
use sdl.rect.Rect;
use sdl.window;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

# handle to an SDL renderer. the zero value (nil handle) is invalid
# ---
# handle: opaque SDL_Renderer pointer, nil when invalid
pub rec Renderer {
    handle: ptr;
}

# handle to an SDL texture. the zero value (nil handle) is invalid
#
# defined here, not in sdl.texture, because mach refuses circular module
# dependencies and drawing needs the type while sdl.texture needs Renderer.
# sdl.texture re-exports it, so it is spelled texture.Texture everywhere.
# ---
# handle: opaque SDL_Texture pointer, nil when invalid
pub rec Texture {
    handle: ptr;
}

# how drawing combines with what is already on the target
# ---
# none:                opaque overwrite
# blend:               alpha blending
# blend_premultiplied: alpha blending, source colors already multiplied by alpha
# add:                 additive blending
# add_premultiplied:   additive blending, source colors already multiplied by alpha
# mod:                 color modulate
# mul:                 color multiply
pub tag Blend: u8 {
    none;
    blend;
    blend_premultiplied;
    add;
    add_premultiplied;
    mod;
    mul;
}

# which way a texture is mirrored when drawn
pub tag Flip: u8 {
    none;
    horizontal;
    vertical;
}

# turn an SDL bool result into err[error.Error]
# ---
# succeeded: the u8 result of an SDL call, nonzero on success
fun to_err(succeeded: u8) err[error.Error] {
    if (succeeded == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# whether a Renderer holds a live handle
# ---
# rend: renderer to test
# ret:  true if the handle is non-nil
pub fun is_valid(rend: Renderer) bool {
    ret rend.handle != nil;
}

# reject a nil renderer before SDL is called
# ---
# rend: renderer the caller is about to use
fun ready(rend: Renderer) err[error.Error] {
    if (!is_valid(rend)) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    ret err[error.Error].ok{};
}

# reject a nil renderer or a nil texture before SDL is called
# ---
# rend: renderer the caller is about to use
# tex:  texture the caller is about to use
fun ready_with(rend: Renderer, tex: Texture) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    if (tex.handle == nil) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    ret err[error.Error].ok{};
}

# the SDL_BlendMode value of a Blend. shared with sdl.texture; not meant for
# use outside this binding
# ---
# mode: blend mode to convert
pub fun blend_to_raw(mode: Blend) u32 {
    if (sel mode.blend)               { ret c.BLENDMODE_BLEND; }
    if (sel mode.blend_premultiplied) { ret c.BLENDMODE_BLEND_PREMULTIPLIED; }
    if (sel mode.add)                 { ret c.BLENDMODE_ADD; }
    if (sel mode.add_premultiplied)   { ret c.BLENDMODE_ADD_PREMULTIPLIED; }
    if (sel mode.mod)                 { ret c.BLENDMODE_MOD; }
    if (sel mode.mul)                 { ret c.BLENDMODE_MUL; }
    ret c.BLENDMODE_NONE;
}

# the Blend of an SDL_BlendMode value. shared with sdl.texture; not meant for
# use outside this binding
# ---
# raw: SDL blend mode value
# ret: the Blend, or error.Error.unsupported for a custom SDL blend mode
pub fun blend_from_raw(raw: u32) res[Blend, error.Error] {
    if (raw == c.BLENDMODE_NONE)                { ret res[Blend, error.Error].ok{ Blend.none{} }; }
    if (raw == c.BLENDMODE_BLEND)               { ret res[Blend, error.Error].ok{ Blend.blend{} }; }
    if (raw == c.BLENDMODE_BLEND_PREMULTIPLIED) { ret res[Blend, error.Error].ok{ Blend.blend_premultiplied{} }; }
    if (raw == c.BLENDMODE_ADD)                 { ret res[Blend, error.Error].ok{ Blend.add{} }; }
    if (raw == c.BLENDMODE_ADD_PREMULTIPLIED)   { ret res[Blend, error.Error].ok{ Blend.add_premultiplied{} }; }
    if (raw == c.BLENDMODE_MOD)                 { ret res[Blend, error.Error].ok{ Blend.mod{} }; }
    if (raw == c.BLENDMODE_MUL)                 { ret res[Blend, error.Error].ok{ Blend.mul{} }; }
    ret res[Blend, error.Error].err{ error.Error.unsupported{} };
}

# the SDL_FlipMode value of a Flip
# ---
# flip: flip to convert
fun flip_to_raw(flip: Flip) u32 {
    if (sel flip.horizontal) { ret c.FLIP_HORIZONTAL; }
    if (sel flip.vertical)   { ret c.FLIP_VERTICAL; }
    ret c.FLIP_NONE;
}

# create a renderer for a window. SDL picks the backend
# ---
# win: window to attach the renderer to
# ret: the new Renderer, or error.Error.invalid for a nil window, or
#      error.Error.failed (text from error.message())
pub fun create(win: window.Window) res[Renderer, error.Error] {
    if (!window.is_valid(win)) {
        ret res[Renderer, error.Error].err{ error.Error.invalid{} };
    }
    val handle: ptr = c.SDL_CreateRenderer(win.handle, nil);
    if (handle == nil) {
        ret res[Renderer, error.Error].err{ error.Error.failed{} };
    }
    ret res[Renderer, error.Error].ok{ Renderer{ handle: handle } };
}

# destroy a renderer and the textures made with it. safe on an invalid handle
# ---
# rend: renderer to destroy
pub fun destroy(rend: Renderer) {
    if (is_valid(rend)) {
        c.SDL_DestroyRenderer(rend.handle);
    }
}

# set the color used by clear and the draw calls until changed again
# ---
# rend: renderer to change
# col:  the new draw color
pub fun set_color(rend: Renderer, col: Color) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderDrawColor(rend.handle, col.r, col.g, col.b, col.a));
}

# clear the current target to the draw color
# ---
# rend: renderer to clear
pub fun clear(rend: Renderer) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderClear(rend.handle));
}

# show everything drawn since the last present
# ---
# rend: renderer to present
pub fun present(rend: Renderer) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderPresent(rend.handle));
}

# fill a rectangle with the draw color
# ---
# rend: renderer to draw with
# rc:   rectangle to fill
pub fun fill_rect(rend: Renderer, rc: FRect) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderFillRect(rend.handle, (?rc)::*c.FRect));
}

# outline a rectangle with the draw color
# ---
# rend: renderer to draw with
# rc:   rectangle to outline
pub fun draw_rect(rend: Renderer, rc: FRect) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderRect(rend.handle, (?rc)::*c.FRect));
}

# draw a line with the draw color
# ---
# rend: renderer to draw with
# a:    start point
# b:    end point
pub fun draw_line(rend: Renderer, a: FPoint, b: FPoint) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderLine(rend.handle, a.x, a.y, b.x, b.y));
}

# draw many points with the draw color
# ---
# rend:  renderer to draw with
# pts:   first of count consecutive points
# count: number of points
pub fun draw_points(rend: Renderer, pts: *FPoint, count: usize) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderPoints(rend.handle, pts::ptr, count::i32));
}

# draw connected line segments through many points with the draw color
# ---
# rend:  renderer to draw with
# pts:   first of count consecutive points
# count: number of points
pub fun draw_lines(rend: Renderer, pts: *FPoint, count: usize) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderLines(rend.handle, pts::ptr, count::i32));
}

# fill many rectangles with the draw color
# ---
# rend:  renderer to draw with
# rects: first of count consecutive rectangles
# count: number of rectangles
pub fun fill_rects(rend: Renderer, rects: *FRect, count: usize) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderFillRects(rend.handle, rects::ptr, count::i32));
}

# draw into a texture instead of the window. the texture must have been
# created with render-target access
# ---
# rend: renderer to retarget
# tex:  texture to draw into
pub fun set_target(rend: Renderer, tex: Texture) err[error.Error] {
    val r: err[error.Error] = ready_with(rend, tex);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderTarget(rend.handle, tex.handle));
}

# draw into the window again
# ---
# rend: renderer to retarget
pub fun reset_target(rend: Renderer) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderTarget(rend.handle, nil));
}

# limit drawing to a rectangle of the target
# ---
# rend: renderer to change
# rc:   clip rectangle in target pixels
pub fun set_clip(rend: Renderer, rc: Rect) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderClipRect(rend.handle, (?rc)::*c.Rect));
}

# remove the clip rectangle
# ---
# rend: renderer to change
pub fun clear_clip(rend: Renderer) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderClipRect(rend.handle, nil));
}

# the current clip rectangle
# ---
# rend: renderer to query
# ret:  the clip rectangle. all zero when none is set or the handle is invalid
pub fun clip(rend: Renderer) Rect {
    var rc: Rect = Rect{ x: 0, y: 0, w: 0, h: 0 };
    if (is_valid(rend)) {
        c.SDL_GetRenderClipRect(rend.handle, (?rc)::*c.Rect);
    }
    ret rc;
}

# scale everything drawn from now on
# ---
# rend: renderer to change
# x:    horizontal scale, 1.0 is unscaled
# y:    vertical scale, 1.0 is unscaled
pub fun set_scale(rend: Renderer, x: f32, y: f32) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderScale(rend.handle, x, y));
}

# the current render scale
# ---
# rend: renderer to query
# ret:  (x, y) scale. (1.0, 1.0) when the handle is invalid
pub fun scale(rend: Renderer) FPoint {
    var x: f32 = 1.0;
    var y: f32 = 1.0;
    if (is_valid(rend)) {
        c.SDL_GetRenderScale(rend.handle, ?x, ?y);
    }
    ret FPoint{ x: x, y: y };
}

# set how drawing combines with what is already on the target
# ---
# rend: renderer to change
# mode: the blend mode
pub fun set_blend(rend: Renderer, mode: Blend) err[error.Error] {
    val r: err[error.Error] = ready(rend);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetRenderDrawBlendMode(rend.handle, blend_to_raw(mode)));
}

# draw a whole texture, stretched to fill a rectangle
# ---
# rend: renderer to draw with
# tex:  texture to draw
# dst:  destination rectangle in target coordinates
pub fun draw_texture(rend: Renderer, tex: Texture, dst: FRect) err[error.Error] {
    val r: err[error.Error] = ready_with(rend, tex);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderTexture(rend.handle, tex.handle, nil, (?dst)::*c.FRect));
}

# draw a whole texture, rotated and optionally mirrored
# ---
# rend:   renderer to draw with
# tex:    texture to draw
# dst:    destination rectangle in target coordinates
# angle:  clockwise rotation in degrees
# center: rotation point, relative to the top-left of dst
# flip:   mirroring, applied before the rotation
pub fun draw_texture_rotated(rend: Renderer, tex: Texture, dst: FRect,
                             angle: f64, center: FPoint, flip: Flip) err[error.Error] {
    val r: err[error.Error] = ready_with(rend, tex);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RenderTextureRotated(rend.handle, tex.handle, nil, (?dst)::*c.FRect,
                                          angle, (?center)::*c.FPoint, flip_to_raw(flip)));
}
