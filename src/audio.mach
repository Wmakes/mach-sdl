# audio playback -- minimal, push-based
#
# open a stream bound to the default output device, push raw samples
# into it yourself, resume (streams start paused). no callback-driven
# playback, no capture/recording, no device enumeration -- deferred
# until something needs them; this covers "play a sound," not a full
# mixer.
#
# genuinely testable headlessly: SDL ships a dummy audio driver the same
# way it ships a dummy video driver (use_dummy_audio_driver in
# sdl.core), so open/resume/destroy all get a real functional test below,
# not just a demo.

use sdl.c;
use sdl.core;
use std.types.bool.bool;
use std.types.size.usize;

pub val FORMAT_S16: u32 = c.AUDIO_FORMAT_S16;
pub val FORMAT_F32: u32 = c.AUDIO_FORMAT_F32;

pub val DEVICE_DEFAULT_PLAYBACK: u32 = c.AUDIO_DEVICE_DEFAULT_PLAYBACK;

# handle to an open playback stream
# ---
# handle: opaque SDL_AudioStream pointer, nil when invalid
pub rec Stream {
    handle: ptr;
}

# whether a Stream holds a live handle
pub fun stream_is_valid(stream: Stream) bool {
    ret stream.handle != nil;
}

# open a stream bound to the default playback device
# ---
# format:   FORMAT_S16 or FORMAT_F32
# channels: 1 (mono) or 2 (stereo)
# freq:     sample rate, e.g. 44100 or 48000
# ret:      the opened Stream; nil handle on failure -- check
#           core.get_error()
pub fun open_playback_stream(format: u32, channels: i32, freq: i32) Stream {
    val spec: c.AudioSpec = c.AudioSpec{ format: format, channels: channels, freq: freq };
    val h: ptr = c.SDL_OpenAudioDeviceStream(DEVICE_DEFAULT_PLAYBACK, ?spec, nil, nil);
    ret Stream{ handle: h };
}

# push raw samples into the stream, matching the format/channels/freq it
# was opened with
# ---
# stream: an open Stream
# buf:    pointer to raw sample data
# len:    length of buf in bytes (not samples/frames)
# ret:    true on success
pub fun put_data(stream: Stream, buf: ptr, len: i32) bool {
    ret c.SDL_PutAudioStreamData(stream.handle, buf, len) != 0;
}

# start (or resume) playback -- streams from open_playback_stream begin
# paused, this is required before anything is actually heard
pub fun resume(stream: Stream) bool {
    ret c.SDL_ResumeAudioStreamDevice(stream.handle) != 0;
}

# pause playback without destroying the stream
pub fun pause(stream: Stream) bool {
    ret c.SDL_PauseAudioStreamDevice(stream.handle) != 0;
}

# destroy a stream
pub fun destroy(stream: Stream) {
    c.SDL_DestroyAudioStream(stream.handle);
}

test "audio: open/resume/put_data/destroy round-trip under the dummy driver" {
    if (!core.use_dummy_audio_driver()) { ret 1; }
    if (!core.init(core.INIT_AUDIO)) { ret 1; }

    val s: Stream = open_playback_stream(FORMAT_S16, 1, 8000);
    if (!stream_is_valid(s)) {
        core.quit();
        ret 1;
    }

    var ok: bool = resume(s);

    var silence: [16]u8;
    var i: usize = 0;
    for (i < 16) {
        silence[i] = 0;
        i = i + 1;
    }
    ok = ok && put_data(s, (?silence[0])::ptr, 16);

    destroy(s);
    core.quit();

    if (!ok) { ret 1; }
    ret 0;
}

test "audio: a nil-handle Stream reports invalid" {
    val s: Stream = Stream{ handle: nil };
    if (stream_is_valid(s)) { ret 1; }
    ret 0;
}
