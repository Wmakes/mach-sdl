# audio playback (sdl.audio)
#
# a Stream is a by-value handle around an SDL_AudioStream bound to the
# default playback device (or one picked from the device list). push raw
# samples into it with put and start it with resume (streams begin paused).
# no callbacks and no capture; this covers "play a sound", not a mixer.
# loading a WAV file into a stream lives in sdl.wav.
#
# every fallible function checks its handle first and returns
# error.Error.invalid for a nil one, so SDL is never called with an invalid
# handle. run use_dummy_audio in sdl.core before init to play headlessly.

use sdl.c;
use sdl.error;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# handle to an open playback stream. the zero value (nil handle) is invalid
# ---
# handle: opaque SDL_AudioStream pointer, nil when invalid
pub rec Stream {
    handle: ptr;
}

# an output device found by playback_device
# ---
# id:   SDL's id for the device, pass it back through open_on
# name: human-readable name, borrowed from SDL: copy it if it must outlive
#       the next SDL call
pub rec Device {
    id:   u32;
    name: str;
}

# the sample format of a stream
# ---
# u8:  unsigned 8-bit integer samples
# s8:  signed 8-bit integer samples
# s16: signed 16-bit integer samples, little-endian
# s32: signed 32-bit integer samples, little-endian
# f32: 32-bit float samples, little-endian
pub tag Format: u8 {
    u8;
    s8;
    s16;
    s32;
    f32;
}

# the SDL_AudioFormat value of a Format
# ---
# format: format to convert
fun format_to_raw(format: Format) u32 {
    if (sel format.u8)  { ret c.AUDIO_FORMAT_U8; }
    if (sel format.s8)  { ret c.AUDIO_FORMAT_S8; }
    if (sel format.s32) { ret c.AUDIO_FORMAT_S32; }
    if (sel format.f32) { ret c.AUDIO_FORMAT_F32; }
    ret c.AUDIO_FORMAT_S16;
}

# the Format of an SDL_AudioFormat value. shared with sdl.wav; not meant for
# use outside this binding
# ---
# raw: SDL audio format value
# ret: the Format, or none for a format this binding does not cover
#      (big-endian variants and the like)
pub fun format_from_raw(raw: u32) opt[Format] {
    if (raw == c.AUDIO_FORMAT_U8)  { ret opt[Format].some{ Format.u8{} }; }
    if (raw == c.AUDIO_FORMAT_S8)  { ret opt[Format].some{ Format.s8{} }; }
    if (raw == c.AUDIO_FORMAT_S16) { ret opt[Format].some{ Format.s16{} }; }
    if (raw == c.AUDIO_FORMAT_S32) { ret opt[Format].some{ Format.s32{} }; }
    if (raw == c.AUDIO_FORMAT_F32) { ret opt[Format].some{ Format.f32{} }; }
    ret opt[Format].none{};
}

# turn an SDL bool result into err[error.Error]
# ---
# succeeded: the u8 result of an SDL call, nonzero on success
fun to_err(succeeded: u8) err[error.Error] {
    if (succeeded == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# whether a Stream holds a live handle
# ---
# stream: stream to test
# ret:    true if the handle is non-nil
pub fun is_valid(stream: Stream) bool {
    ret stream.handle != nil;
}

# reject a nil stream before SDL is called
# ---
# stream: stream the caller is about to use
fun ready(stream: Stream) err[error.Error] {
    if (!is_valid(stream)) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    ret err[error.Error].ok{};
}

# open a stream on a playback device
# ---
# devid:    SDL device id, or the default-playback id
# format:   the sample format
# channels: channel count
# freq:     sample rate in Hz
fun open_id(devid: u32, format: Format, channels: i32, freq: i32) res[Stream, error.Error] {
    val spec: c.AudioSpec = c.AudioSpec{ format: format_to_raw(format), channels: channels, freq: freq };
    val handle: ptr = c.SDL_OpenAudioDeviceStream(devid, ?spec, nil, nil);
    if (handle == nil) {
        ret res[Stream, error.Error].err{ error.Error.failed{} };
    }
    ret res[Stream, error.Error].ok{ Stream{ handle: handle } };
}

# open a stream bound to the default playback device. it starts paused
# ---
# format:   the sample format
# channels: 1 (mono) or 2 (stereo)
# freq:     sample rate in Hz, e.g. 44100 or 48000
# ret:      the new Stream, or error.Error.failed (text from error.message())
pub fun open(format: Format, channels: i32, freq: i32) res[Stream, error.Error] {
    ret open_id(c.AUDIO_DEVICE_DEFAULT_PLAYBACK, format, channels, freq);
}

# open a stream bound to a specific playback device. it starts paused
# ---
# dev:      a device from playback_device
# format:   the sample format
# channels: 1 (mono) or 2 (stereo)
# freq:     sample rate in Hz
# ret:      the new Stream, or error.Error.failed (text from error.message())
pub fun open_on(dev: Device, format: Format, channels: i32, freq: i32) res[Stream, error.Error] {
    ret open_id(dev.id, format, channels, freq);
}

# how many playback devices SDL currently lists
# ---
# ret: the count, 0 if there are none or SDL reports failure
pub fun playback_device_count() i32 {
    var count: i32 = 0;
    val ids: ptr = c.SDL_GetAudioPlaybackDevices(?count);
    if (ids == nil) {
        ret 0;
    }
    c.SDL_free(ids);
    ret count;
}

# the playback device at a position in SDL's current list. the binding reads
# and frees SDL's device array itself, so there is nothing to release
#
# the list can change as devices come and go, so an index is only meaningful
# right after playback_device_count.
# ---
# index: position, from 0 up to playback_device_count() - 1
# ret:   the Device, or none for an index out of range or if SDL fails
pub fun playback_device(index: i32) opt[Device] {
    var count: i32 = 0;
    val ids: ptr = c.SDL_GetAudioPlaybackDevices(?count);
    if (ids == nil) {
        ret opt[Device].none{};
    }
    if (index < 0 || index >= count) {
        c.SDL_free(ids);
        ret opt[Device].none{};
    }
    val id: u32 = ((ids::usize + (index::usize) * 4)::*u32)[0];
    c.SDL_free(ids);
    val raw: *u8 = c.SDL_GetAudioDeviceName(id);
    if (raw == nil) {
        ret opt[Device].none{};
    }
    val name: str = raw;
    ret opt[Device].some{ Device{ id: id, name: name } };
}

# close a stream and its device. safe on an invalid handle
# ---
# stream: stream to close
pub fun close(stream: Stream) {
    if (is_valid(stream)) {
        c.SDL_DestroyAudioStream(stream.handle);
    }
}

# queue raw samples for playback. they must match the format, channels and
# frequency the stream was opened with
# ---
# stream: an open stream
# data:   pointer to the raw sample bytes
# len:    length of data in bytes (not samples or frames); SDL takes at most
#         2147483647 bytes per call
# ret:    ok, or error.Error.invalid for a nil stream or a len over the limit,
#         or error.Error.failed (text from error.message())
pub fun put(stream: Stream, data: *u8, len: usize) err[error.Error] {
    val r: err[error.Error] = ready(stream);
    if (!sel r.ok) { ret r; }
    if (len > (2147483647::usize)) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    ret to_err(c.SDL_PutAudioStreamData(stream.handle, data::ptr, len::i32));
}

# start or resume playback. nothing is heard until this is called
# ---
# stream: stream to start
pub fun resume(stream: Stream) err[error.Error] {
    val r: err[error.Error] = ready(stream);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_ResumeAudioStreamDevice(stream.handle));
}

# pause playback without closing the stream
# ---
# stream: stream to pause
pub fun pause(stream: Stream) err[error.Error] {
    val r: err[error.Error] = ready(stream);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_PauseAudioStreamDevice(stream.handle));
}

# discard all queued samples without closing the stream
# ---
# stream: stream to clear
pub fun clear(stream: Stream) err[error.Error] {
    val r: err[error.Error] = ready(stream);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_ClearAudioStream(stream.handle));
}

# how many bytes are queued in the stream
# ---
# stream: stream to query
# ret:    the byte count, or -1 for a nil stream or if SDL reports failure
pub fun queued(stream: Stream) i32 {
    if (!is_valid(stream)) {
        ret -1;
    }
    ret c.SDL_GetAudioStreamAvailable(stream.handle);
}
