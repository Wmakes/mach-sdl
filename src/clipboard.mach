# clipboard text (sdl.clipboard)
#
# text only: no clipboard images or custom mime types.
#
# the string returned by text() is a fresh allocation on every call, NOT
# borrowed like error.message(): give it back with free_text() when done,
# or it leaks.

use sdl.c;
use sdl.error;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

# turn an SDL bool result into err[error.Error]
# ---
# succeeded: the u8 result of an SDL call, nonzero on success
fun to_err(succeeded: u8) err[error.Error] {
    if (succeeded == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# whether the clipboard currently holds text
# ---
# ret: true if there is text to read
pub fun has_text() bool {
    ret c.SDL_HasClipboardText() != 0;
}

# replace the clipboard's text
# ---
# text: the new clipboard text
# ret:  ok, or error.Error.failed (text from error.message())
pub fun set_text(text: str) err[error.Error] {
    ret to_err(c.SDL_SetClipboardText(text));
}

# the clipboard's current text. release it with free_text
#
# an empty clipboard gives an empty string, not an error. use has_text to
# tell the two apart.
# ---
# ret: the text (SDL-allocated, caller must call free_text). SDL reports a
#      failed read as an empty string, so it looks like an empty clipboard;
#      error.Error.failed only comes back if SDL hands back no string at
#      all (out of memory), text from error.message()
pub fun text() res[str, error.Error] {
    val raw: *u8 = c.SDL_GetClipboardText();
    if (raw == nil) {
        ret res[str, error.Error].err{ error.Error.failed{} };
    }
    val s: str = raw;
    ret res[str, error.Error].ok{ s };
}

# release a string returned by text()
# ---
# text: the string to free; do not use it afterwards
pub fun free_text(text: str) {
    c.SDL_free(text::ptr);
}
