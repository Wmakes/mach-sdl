pub val F3:  u32 = 60;
pub val F4:  u32 = 61;
pub val F5:  u32 = 62;
pub val F6:  u32 = 63;
pub val F7:  u32 = 64;
pub val F8:  u32 = 65;
pub val F9:  u32 = 66;
pub val F10: u32 = 67;
pub val F11: u32 = 68;
pub val F12: u32 = 69;

pub val RIGHT: u32 = 79;
pub val LEFT:  u32 = 80;
pub val DOWN:  u32 = 81;
pub val UP:    u32 = 82;

pub val LCTRL:  u32 = 224;
pub val LSHIFT: u32 = 225;
pub val LALT:   u32 = 226;
pub val RCTRL:  u32 = 228;
pub val RSHIFT: u32 = 229;
pub val RALT:   u32 = 230;
