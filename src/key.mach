# physical key scancodes and keyboard state (sdl.key)
#
# a scancode names a physical key position, independent of keyboard layout.
# use it against KeyEvent.scancode and is_down(); it is the right choice for
# movement and action keys (the physical key where QWERTY has W is labelled
# Z on an AZERTY board, so the scancode W keeps the movement cluster under
# the left hand there, printed ZQSD).
#
# constants: letters A to Z, top-row digits NUM_0 to NUM_9, RETURN, ESCAPE,
# BACKSPACE, TAB, SPACE, F1 to F12, the arrows LEFT, RIGHT, UP, DOWN, and
# the modifier keys LCTRL, LSHIFT, LALT, RCTRL, RSHIFT, RALT. modifier bits
# for KeyEvent.mods and mods() are MOD_SHIFT, MOD_CTRL, MOD_ALT, MOD_GUI.

use sdl.c;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.size.usize;

# letters
pub val A: u32 = 4;
pub val B: u32 = 5;
pub val C: u32 = 6;
pub val D: u32 = 7;
pub val E: u32 = 8;
pub val F: u32 = 9;
pub val G: u32 = 10;
pub val H: u32 = 11;
pub val I: u32 = 12;
pub val J: u32 = 13;
pub val K: u32 = 14;
pub val L: u32 = 15;
pub val M: u32 = 16;
pub val N: u32 = 17;
pub val O: u32 = 18;
pub val P: u32 = 19;
pub val Q: u32 = 20;
pub val R: u32 = 21;
pub val S: u32 = 22;
pub val T: u32 = 23;
pub val U: u32 = 24;
pub val V: u32 = 25;
pub val W: u32 = 26;
pub val X: u32 = 27;
pub val Y: u32 = 28;
pub val Z: u32 = 29;

# top-row digits
pub val NUM_1: u32 = 30;
pub val NUM_2: u32 = 31;
pub val NUM_3: u32 = 32;
pub val NUM_4: u32 = 33;
pub val NUM_5: u32 = 34;
pub val NUM_6: u32 = 35;
pub val NUM_7: u32 = 36;
pub val NUM_8: u32 = 37;
pub val NUM_9: u32 = 38;
pub val NUM_0: u32 = 39;

# control and whitespace
pub val RETURN: u32 = 40;
pub val ESCAPE: u32 = 41;
pub val BACKSPACE: u32 = 42;
pub val TAB: u32 = 43;
pub val SPACE: u32 = 44;

# function keys
pub val F1: u32 = 58;
pub val F2: u32 = 59;
pub val F3: u32 = 60;
pub val F4: u32 = 61;
pub val F5: u32 = 62;
pub val F6: u32 = 63;
pub val F7: u32 = 64;
pub val F8: u32 = 65;
pub val F9: u32 = 66;
pub val F10: u32 = 67;
pub val F11: u32 = 68;
pub val F12: u32 = 69;

# arrows
pub val RIGHT: u32 = 79;
pub val LEFT: u32 = 80;
pub val DOWN: u32 = 81;
pub val UP: u32 = 82;

# modifiers (physical keys)
pub val LCTRL: u32 = 224;
pub val LSHIFT: u32 = 225;
pub val LALT: u32 = 226;
pub val RCTRL: u32 = 228;
pub val RSHIFT: u32 = 229;
pub val RALT: u32 = 230;

# modifier bit: either shift key. test with (mods & key.MOD_SHIFT) != 0
pub val MOD_SHIFT: u16 = 0x0003;
# modifier bit: either ctrl key
pub val MOD_CTRL:  u16 = 0x00C0;
# modifier bit: either alt key
pub val MOD_ALT:   u16 = 0x0300;
# modifier bit: either GUI key (Windows / Command / Super)
pub val MOD_GUI:   u16 = 0x0C00;


# whether the key with this scancode is held down right now
# ---
# scancode: a key constant from this module (e.g. ESCAPE)
# ret:      true while held; false for an out-of-range scancode
pub fun is_down(scancode: u32) bool {
    var count: i32 = 0;
    val state: *u8 = c.SDL_GetKeyboardState(?count)::*u8;
    if (scancode >= count::u32) {
        ret false;
    }
    ret state[scancode::usize] != 0;
}

# the modifier keys held right now, as a bitmask of MOD_* values
# ---
# ret: the modifier bits; test with e.g. (key.mods() & key.MOD_CTRL) != 0
pub fun mods() u16 {
    ret c.SDL_GetModState();
}
