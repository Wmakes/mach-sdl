# event queue polling
#
# SDL delivers input through a poll-into-a-struct queue, not callbacks
# like GLFW -- call poll_event once per loop iteration until it returns
# false, then check event_type() and pull the specific sub-struct you
# need (as_keyboard, etc.) for that iteration's event.
#
# Event is a 128-byte union; KeyboardEvent is 40. Since they're different
# sizes, `:~` (bit-reinterpret) doesn't apply -- it only works between
# same-size types. Instead, reinterpret the *pointer* with `::` (an
# ordinary pointer-value cast) and dereference to copy out the sub-struct
# by value.

use sdl.c;
use sdl.core;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;

pub val EVENT_QUIT:     u32 = c.EVENT_QUIT;
pub val EVENT_KEY_DOWN: u32 = c.EVENT_KEY_DOWN;
pub val EVENT_KEY_UP:   u32 = c.EVENT_KEY_UP;

pub val EVENT_WINDOW_RESIZED:         u32 = c.EVENT_WINDOW_RESIZED;
pub val EVENT_WINDOW_FOCUS_GAINED:    u32 = c.EVENT_WINDOW_FOCUS_GAINED;
pub val EVENT_WINDOW_FOCUS_LOST:      u32 = c.EVENT_WINDOW_FOCUS_LOST;
pub val EVENT_WINDOW_CLOSE_REQUESTED: u32 = c.EVENT_WINDOW_CLOSE_REQUESTED;

pub val EVENT_MOUSE_MOTION:      u32 = c.EVENT_MOUSE_MOTION;
pub val EVENT_MOUSE_BUTTON_DOWN: u32 = c.EVENT_MOUSE_BUTTON_DOWN;
pub val EVENT_MOUSE_BUTTON_UP:   u32 = c.EVENT_MOUSE_BUTTON_UP;
pub val EVENT_MOUSE_WHEEL:       u32 = c.EVENT_MOUSE_WHEEL;

# pull the next event off the queue, if any
# ---
# event: out-param, filled when this returns true
# ret:   true if an event was pulled, false if the queue was empty
pub fun poll_event(event: *c.Event) bool {
    ret c.SDL_PollEvent(event) != 0;
}

# the event's type tag -- check this before calling as_keyboard etc.
# ---
# event: an event already filled by poll_event
# ret:   one of the EVENT_* constants (or an SDL event type this binding
#        doesn't cover yet)
pub fun event_type(event: *c.Event) u32 {
    ret (@event).event_type;
}

# reinterpret a key event as its full KeyboardEvent -- only valid when
# event_type() is EVENT_KEY_DOWN or EVENT_KEY_UP
# ---
# event: an event already filled by poll_event
# ret:   the KeyboardEvent, copied out by value
pub fun as_keyboard(event: *c.Event) c.KeyboardEvent {
    val kb: *c.KeyboardEvent = event::*c.KeyboardEvent;
    ret @kb;
}

# reinterpret a window event -- valid for any EVENT_WINDOW_* type
# ---
# event: an event already filled by poll_event
# ret:   the WindowEvent, copied out by value
pub fun as_window(event: *c.Event) c.WindowEvent {
    val w: *c.WindowEvent = event::*c.WindowEvent;
    ret @w;
}

# reinterpret a mouse motion event -- only valid when event_type() is
# EVENT_MOUSE_MOTION
# ---
# event: an event already filled by poll_event
# ret:   the MouseMotionEvent, copied out by value
pub fun as_mouse_motion(event: *c.Event) c.MouseMotionEvent {
    val m: *c.MouseMotionEvent = event::*c.MouseMotionEvent;
    ret @m;
}

# reinterpret a mouse button event -- only valid when event_type() is
# EVENT_MOUSE_BUTTON_DOWN or EVENT_MOUSE_BUTTON_UP
# ---
# event: an event already filled by poll_event
# ret:   the MouseButtonEvent, copied out by value
pub fun as_mouse_button(event: *c.Event) c.MouseButtonEvent {
    val m: *c.MouseButtonEvent = event::*c.MouseButtonEvent;
    ret @m;
}

# reinterpret a mouse wheel event -- only valid when event_type() is
# EVENT_MOUSE_WHEEL
# ---
# event: an event already filled by poll_event
# ret:   the MouseWheelEvent, copied out by value
pub fun as_mouse_wheel(event: *c.Event) c.MouseWheelEvent {
    val m: *c.MouseWheelEvent = event::*c.MouseWheelEvent;
    ret @m;
}

# whether a KeyboardEvent represents a key going down (vs. up, or a repeat)
# ---
# key: a KeyboardEvent from as_keyboard
# ret: true if this is a fresh key-down (not a held-key repeat)
pub fun key_is_fresh_press(key: c.KeyboardEvent) bool {
    ret key.down != 0 && key.repeat == 0;
}

test "events: key_is_fresh_press distinguishes press, repeat, and release" {
    # pure logic, no SDL call involved -- constructing the struct by hand
    var fresh: c.KeyboardEvent;
    fresh.down   = 1;
    fresh.repeat = 0;
    if (!key_is_fresh_press(fresh)) { ret 1; }

    var repeated: c.KeyboardEvent;
    repeated.down   = 1;
    repeated.repeat = 1;
    if (key_is_fresh_press(repeated)) { ret 1; }

    var released: c.KeyboardEvent;
    released.down   = 0;
    released.repeat = 0;
    if (key_is_fresh_press(released)) { ret 1; }

    ret 0;
}

test "events: poll_event drains without crashing under the dummy driver" {
    if (!core.use_dummy_video_driver()) { ret 1; }
    if (!core.init(core.INIT_VIDEO)) { ret 1; }

    var ev: c.Event;
    var drained: bool = false;
    var tries: i64 = 0;

    for (tries < 1000) {
        if (!poll_event(?ev)) {
            drained = true;
            brk;
        }
        tries = tries + 1;
    }

    core.quit();
    if (!drained) { ret 1; }
    ret 0;
}
