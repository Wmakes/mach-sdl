# window lifecycle
#
# a Window is a by-value wrapper around the opaque SDL_Window handle.
# fallible constructors return a nil-handle Window; check with
# window_is_valid and query sdl.core.get_error for the cause.

use sdl.c;
use sdl.core;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.string.str;


# handle to an SDL window
# ---
# handle: opaque SDL_Window pointer, nil when invalid
pub rec Window {
    handle: ptr;
}

pub val WINDOW_OPENGL:    u64 = c.WINDOW_OPENGL;
pub val WINDOW_RESIZABLE: u64 = c.WINDOW_RESIZABLE;

# whether a Window holds a live handle
# ---
# window: window to test
# ret:    true if the handle is non-nil
pub fun window_is_valid(window: Window) bool {
    ret window.handle != nil;
}

# create a window
# ---
# title:  UTF-8 window title
# w:      width in pixels
# h:      height in pixels
# flags:  bitwise OR of WINDOW_* values
# ret:    the new Window; nil handle on failure -- check core.get_error()
pub fun create_window(title: str, w: i32, h: i32, flags: u64) Window {
    ret Window{ handle: c.SDL_CreateWindow(title, w, h, flags) };
}

# create_window sugar for the common windowed-with-GL case
# ---
# title: UTF-8 window title
# w:     width in pixels
# h:     height in pixels
# ret:   the new Window; nil handle on failure
pub fun open_gl_window(title: str, w: i32, h: i32) Window {
    ret create_window(title, w, h, WINDOW_OPENGL | WINDOW_RESIZABLE);
}

# destroy a window and its context
# ---
# window: window to destroy
pub fun destroy_window(window: Window) {
    c.SDL_DestroyWindow(window.handle);
}

# change a window's title
pub fun set_title(window: Window, title: str) bool {
    ret c.SDL_SetWindowTitle(window.handle, title) != 0;
}

# plain width/height pair, in pixels
pub rec Size {
    w: i32;
    h: i32;
}

# a window's current size in pixels
# ---
# ret: (width, height); (0, 0) if the query fails
pub fun get_size(window: Window) Size {
    var w: i32 = 0;
    var h: i32 = 0;
    c.SDL_GetWindowSize(window.handle, ?w, ?h);
    ret Size{ w: w, h: h };
}

# move a window
pub fun set_position(window: Window, x: i32, y: i32) bool {
    ret c.SDL_SetWindowPosition(window.handle, x, y) != 0;
}

# toggle fullscreen (borderless, desktop-resolution -- not exclusive
# fullscreen/videomode-change; that's a separate, unbound SDL call)
pub fun set_fullscreen(window: Window, fullscreen: bool) bool {
    var flag: u8 = 0;
    if (fullscreen) { flag = 1; }
    ret c.SDL_SetWindowFullscreen(window.handle, flag) != 0;
}

test "window: create_window/destroy_window round-trip under the dummy driver" {
    if (!core.use_dummy_video_driver()) { ret 1; }
    if (!core.init(core.INIT_VIDEO)) { ret 1; }

    # no WINDOW_OPENGL here on purpose -- the dummy driver doesn't support
    # GL, this test is only checking the window/plumbing works, not GL.
    val w: Window = create_window("mach-sdl test", 320, 240, 0);
    if (!window_is_valid(w)) {
        core.quit();
        ret 1;
    }

    destroy_window(w);
    core.quit();
    ret 0;
}

test "window: a nil-handle Window reports invalid" {
    val w: Window = Window{ handle: nil };
    if (window_is_valid(w)) { ret 1; }
    ret 0;
}
