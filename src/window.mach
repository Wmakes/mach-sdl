# window lifecycle and properties (sdl.window)
#
# sizes and positions are in SDL's screen coordinates, which differ from the
# drawable size in real pixels on a high-DPI display.
#
# a Window is a by-value handle around SDL_Window. every fallible function
# checks the handle first and returns error.Error.invalid for a nil one, so
# SDL is never called with an invalid handle.

use sdl.c;
use sdl.error;
use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

# handle to an SDL window. the zero value (nil handle) is invalid
# ---
# handle: opaque SDL_Window pointer, nil when invalid
pub rec Window {
    handle: ptr;
}

# a window size in screen coordinates
pub rec Size {
    w: i32;
    h: i32;
}

pub val OPENGL:    u64 = c.WINDOW_OPENGL;
pub val RESIZABLE: u64 = c.WINDOW_RESIZABLE;

# whether a Window holds a live handle
# ---
# win: window to test
# ret: true if the handle is non-nil
pub fun is_valid(win: Window) bool {
    ret win.handle != nil;
}

# turn an SDL bool result into err[error.Error]
# ---
# succeeded: the u8 result of an SDL call, nonzero on success
fun to_err(succeeded: u8) err[error.Error] {
    if (succeeded == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# reject a nil handle before SDL is called
# ---
# win: window the caller is about to use
fun ready(win: Window) err[error.Error] {
    if (!is_valid(win)) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    ret err[error.Error].ok{};
}

# create a window. call sdl.core.init(VIDEO) first
# ---
# title: UTF-8 window title
# w:     width in screen coordinates
# h:     height in screen coordinates
# flags: bitwise OR of OPENGL and RESIZABLE
# ret:   the new Window, or error.Error.failed (text from error.message())
pub fun create(title: str, w: i32, h: i32, flags: u64) res[Window, error.Error] {
    val handle: ptr = c.SDL_CreateWindow(title, w, h, flags);
    if (handle == nil) {
        ret res[Window, error.Error].err{ error.Error.failed{} };
    }
    ret res[Window, error.Error].ok{ Window{ handle: handle } };
}

# destroy a window and its resources. safe on an invalid handle
# ---
# win: window to destroy
pub fun destroy(win: Window) {
    if (is_valid(win)) {
        c.SDL_DestroyWindow(win.handle);
    }
}

# set the window title
# ---
# title: UTF-8 title
pub fun set_title(win: Window, title: str) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowTitle(win.handle, title));
}

# the window size in screen coordinates
# ---
# ret: the size, or an error.Error on failure
pub fun size(win: Window) res[Size, error.Error] {
    val r: err[error.Error] = ready(win);
    if (sel r.err) { ret res[Size, error.Error].err{ r.err }; }
    var w: i32 = 0;
    var h: i32 = 0;
    if (c.SDL_GetWindowSize(win.handle, ?w, ?h) == 0) {
        ret res[Size, error.Error].err{ error.Error.failed{} };
    }
    ret res[Size, error.Error].ok{ Size{ w: w, h: h } };
}

# resize the window
# ---
# w: width in screen coordinates
# h: height in screen coordinates
pub fun set_size(win: Window, w: i32, h: i32) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowSize(win.handle, w, h));
}

# move the window on the desktop
# ---
# x: x position in screen coordinates
# y: y position in screen coordinates
pub fun set_position(win: Window, x: i32, y: i32) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowPosition(win.handle, x, y));
}

# switch the window to or from fullscreen
# ---
# on: true for fullscreen
pub fun set_fullscreen(win: Window, on: bool) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowFullscreen(win.handle, on));
}

# set the smallest size the user can resize to
# ---
# w: minimum width in screen coordinates
# h: minimum height in screen coordinates
pub fun set_min_size(win: Window, w: i32, h: i32) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowMinimumSize(win.handle, w, h));
}

# set the largest size the user can resize to. 0 means no limit
# ---
# w: maximum width in screen coordinates
# h: maximum height in screen coordinates
pub fun set_max_size(win: Window, w: i32, h: i32) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowMaximumSize(win.handle, w, h));
}

# minimize the window
pub fun minimize(win: Window) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_MinimizeWindow(win.handle));
}

# maximize the window
pub fun maximize(win: Window) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_MaximizeWindow(win.handle));
}

# restore a minimized or maximized window
pub fun restore(win: Window) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RestoreWindow(win.handle));
}

# raise the window above others and give it input focus
pub fun raise(win: Window) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_RaiseWindow(win.handle));
}
