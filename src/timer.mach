# timing (sdl.timer)
#
# raw millisecond and nanosecond tick counters, a delay, and Clock: the
# thing a game loop actually needs, seconds elapsed since the last frame
# instead of a raw counter you convert yourself.

use sdl.c;

# a running delta-time clock, backed by the high-resolution performance
# counter. its units are not fixed at milliseconds the way ticks_ms is, so
# tick converts with SDL_GetPerformanceFrequency
# ---
# last: performance-counter value at the last tick call
pub rec Clock {
    last: u64;
}

# milliseconds since SDL library init
# ---
# ret: the millisecond count
pub fun ticks_ms() u64 {
    ret c.SDL_GetTicks();
}

# nanoseconds since SDL library init. higher resolution than ticks_ms
# ---
# ret: the nanosecond count
pub fun ticks_ns() u64 {
    ret c.SDL_GetTicksNS();
}

# sleep the calling thread
# ---
# ms: milliseconds to sleep
pub fun delay(ms: u32) {
    c.SDL_Delay(ms);
}

# start a clock, timed from right now
# ---
# ret: a Clock ready for its first tick
pub fun clock() Clock {
    ret Clock{ last: c.SDL_GetPerformanceCounter() };
}

# seconds elapsed since this clock's previous tick (or since clock(), on the
# first call). call it once per frame and scale movement by the result so
# speed does not depend on the frame rate
# ---
# clk: clock to advance
# ret: elapsed seconds
pub fun tick(clk: *Clock) f64 {
    val now:  u64 = c.SDL_GetPerformanceCounter();
    val freq: u64 = c.SDL_GetPerformanceFrequency();

    val elapsed: f64 = ((now - (@clk).last)::f64) / (freq::f64);
    (@clk).last = now;
    ret elapsed;
}

test timer_a_fresh_clock_s_first_tick_is_not_negative_or_absurd {
    var clk: Clock = clock();
    delay(5);
    val dt: f64 = tick(?clk);
    if (dt < 0.0) { ret 1; }
    if (dt > 5.0) { ret 1; }  # sanity ceiling, not a real timing assertion
    ret 0;
}

test timer_ticks_ms_is_non_decreasing_across_a_short_delay {
    val before: u64 = ticks_ms();
    delay(2);
    val after: u64 = ticks_ms();
    if (after < before) { ret 1; }
    ret 0;
}
