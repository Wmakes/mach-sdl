# demo / smoke test for mach-sdl
#
# one run exercises every module of the bindings except sdl.wav (and the
# device-list functions in sdl.audio):
#
#   core       init (video + audio), quit
#   window     create (GL window and plain window), set_title, size,
#              set_fullscreen, minimize / restore
#   gl         create_context, proc_address, swap, legacy immediate-mode
#              drawing in the main window
#   renderer   create, set_color, clear, fill_rect, draw_rect, set_blend,
#              set_clip, draw_points, draw_lines, fill_rects in the second
#              window; texture.load on a missing file shows the failure path
#   event      poll() into the typed Event tag: keys, mouse, wheel, resize
#   key        scancode constants: WASD, F, M, L, N, C, V, P, SPACE, ESC
#   mouse      state() each frame, show / hide cursor (M), relative mode (L)
#   timer      Clock / tick drives delta-time movement
#   audio      open + put + resume: a square-wave beep on SPACE
#   rect       intersects: a collectible that respawns when you touch it
#   rand       seeded from ticks_ns, range places the collectible
#   clipboard  set_text / text / free_text round trip (C and V)
#   msgbox     info dialog on exit (blocks until you click OK)
#   error      message() for every failure report
#   font       init, open (expected failure + real font), family_name, height,
#              measure, set_style, render_texture / render_texture_wrapped:
#              a live score label and a static help label in the renderer
#              window
#   image      version, load_texture on a missing file shows the failure
#              path; with an image argument: detect, load_animation,
#              animation_info / animation_frame_texture / animation_delay
#              (GIF and WebP play in the renderer window, a still image is
#              one frame); P takes a screenshot: renderer.read_pixels,
#              save_png, save_jpg, then detect / load / load_texture them
#              back and show the PNG as a thumbnail
#
# controls: WASD move, SPACE beep, M cursor, F fullscreen, L relative mouse,
# N minimize / restore the renderer window, C copy, V paste, P screenshot,
# ESC quit.
#
# font: pass a .ttf path as the first argument, otherwise a few common system
# fonts are tried. with no usable font the demo runs without text.
#
# image: pass an image file (PNG, JPG, GIF, WebP, ...) as the second
# argument. to give an image but use a system font, pass "-" as the font. the
# screenshot is written to mach-sdl-shot.png and mach-sdl-shot.jpg in the
# current directory.

use std.runtime;
use print: std.print;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use sdl.audio;
use sdl.clipboard;
use sdl.color.Color;
use sdl.core;
use sdl.error;
use sdl.event;
use sdl.font;
use sdl.gl;
use sdl.image;
use sdl.key;
use sdl.mouse;
use sdl.msgbox;
use sdl.rand;
use sdl.rect;
use sdl.renderer;
use sdl.surface;
use sdl.texture;
use sdl.timer;
use sdl.window;

def GlClearColorFun:   fun(f32, f32, f32, f32);
def GlClearFun:        fun(u32);
def GlViewportFun:     fun(i32, i32, i32, i32);
def GlMatrixModeFun:   fun(u32);
def GlLoadIdentityFun: fun();
def GlOrthoFun:        fun(f64, f64, f64, f64, f64, f64);
def GlBeginFun:        fun(u32);
def GlEndFun:          fun();
def GlVertex2fFun:     fun(f32, f32);
def GlColor3fFun:      fun(f32, f32, f32);

val GL_COLOR_BUFFER_BIT: u32 = 0x00004000;
val GL_PROJECTION:       u32 = 0x1701;
val GL_MODELVIEW:        u32 = 0x1700;
val GL_QUADS:            u32 = 0x0007;
val MOVE_SPEED:          f32 = 200.0;
val HALF:                f32 = 20.0;
val BEEP_SAMPLES:        i64 = 1200;
val BEEP_HALF_PERIOD:    i64 = 9;
val BEEP_AMPLITUDE:      i16 = 3000;

# print "<msg>: <SDL error text>" to stderr and give back the exit code 1
fun fail(msg: str) i64 {
    print.eprint(msg);
    print.eprint(": ");
    print.eprintln(error.message());
    ret 1;
}

# look up a GL function by name, nil when the driver does not have it
fun load_gl(name: str) ptr {
    val found: opt[ptr] = gl.proc_address(name);
    if (!sel found.some) { ret nil; }
    ret found.some;
}

fun color_of(r: u8, g: u8, b: u8, a: u8) Color {
    ret Color{ r: r, g: g, b: b, a: a };
}

# a short s16 mono square wave
fun fill_beep(buf: *u8) {
    var i: i64 = 0;
    for (i < BEEP_SAMPLES) {
        var v: i16 = BEEP_AMPLITUDE;
        if ((i / BEEP_HALF_PERIOD) % 2 == 1) { v = 0 - BEEP_AMPLITUDE; }
        val u: u16 = v::u16;
        val o: usize = (i::usize) * 2;
        buf[o]     = (u & 0xFF)::u8;
        buf[o + 1] = (u >> 8)::u8;
        i = i + 1;
    }
}

fun draw_square(gl_begin: GlBeginFun, gl_end: GlEndFun,
                vertex2f: GlVertex2fFun, color3f: GlColor3fFun,
                px: f32, py: f32, r: f32, g: f32, b: f32) {
    color3f(r, g, b);
    gl_begin(GL_QUADS);
    vertex2f(px - HALF, py - HALF);
    vertex2f(px + HALF, py - HALF);
    vertex2f(px + HALF, py + HALF);
    vertex2f(px - HALF, py + HALF);
    gl_end();
}

fun spawn_collectible(win_w: f32, win_h: f32) rect.FRect {
    val cx: f32 = rand.range(HALF + 5.0, win_w - HALF - 5.0);
    val cy: f32 = rand.range(HALF + 5.0, win_h - HALF - 5.0);
    ret rect.FRect{ x: cx - HALF, y: cy - HALF, w: HALF * 2.0, h: HALF * 2.0 };
}

# write "Score: <n>" as a NUL-terminated string into buf (32 bytes is plenty)
fun format_score(buf: *u8, n: i64) {
    buf[0] = 0x53;
    buf[1] = 0x63;
    buf[2] = 0x6F;
    buf[3] = 0x72;
    buf[4] = 0x65;
    buf[5] = 0x3A;
    buf[6] = 0x20;

    var digits: [20]u8;
    var count: usize = 0;
    var rest: i64 = n;
    if (rest <= 0) {
        digits[0] = 0x30;
        count = 1;
    }
    for (rest > 0) {
        digits[count] = (0x30 + (rest % 10))::u8;
        rest = rest / 10;
        count = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        buf[7 + i] = digits[count - 1 - i];
        i = i + 1;
    }
    buf[7 + count] = 0;
}

# try a few common system font locations, so the demo needs no bundled asset.
# returns the last failure when none exists
fun open_any_font(size: f32) res[font.Font, error.Error] {
    val a: res[font.Font, error.Error] = font.open("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", size);
    if (sel a.ok) { ret a; }
    val b: res[font.Font, error.Error] = font.open("/usr/share/fonts/TTF/DejaVuSans.ttf", size);
    if (sel b.ok) { ret b; }
    val c: res[font.Font, error.Error] = font.open("/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf", size);
    if (sel c.ok) { ret c; }
    val d: res[font.Font, error.Error] = font.open("C:/Windows/Fonts/arial.ttf", size);
    if (sel d.ok) { ret d; }
    ret font.open("/System/Library/Fonts/Supplemental/Arial.ttf", size);
}

# scale a w x h image to fit a square box, keeping its aspect ratio
fun fit(w: f32, h: f32, box: f32, x: f32, y: f32) rect.FRect {
    if (w <= 0.0 || h <= 0.0) {
        ret rect.FRect{ x: x, y: y, w: box, h: box };
    }
    var s: f32 = box / w;
    if (box / h < s) { s = box / h; }
    ret rect.FRect{ x: x, y: y, w: w * s, h: h * s };
}

# upload frame `index` of an animation. a nil-handle texture on failure
fun frame_texture(rend: renderer.Renderer, anim: image.Animation, index: i32) renderer.Texture {
    val made: res[texture.Texture, error.Error] = image.animation_frame_texture(rend, anim, index);
    if (sel made.ok) { ret made.ok; }
    print.eprint("animation frame failed: ");
    print.eprintln(error.message());
    ret renderer.Texture{ handle: nil };
}

# P: save the renderer window as PNG and JPG, then read both back to check
# the round trip. call after drawing and before present. returns the PNG as
# a texture, a nil-handle texture on failure
fun screenshot(rend: renderer.Renderer) renderer.Texture {
    val none: renderer.Texture = renderer.Texture{ handle: nil };
    val grabbed: res[surface.Surface, error.Error] = renderer.read_pixels(rend);
    if (sel grabbed.err) {
        print.eprint("screenshot: read_pixels failed: ");
        print.eprintln(error.message());
        ret none;
    }
    val png_saved: err[error.Error] = image.save_png(grabbed.ok, "mach-sdl-shot.png");
    if (sel png_saved.err) {
        print.eprint("screenshot: save_png failed: ");
        print.eprintln(error.message());
    }
    val jpg_saved: err[error.Error] = image.save_jpg(grabbed.ok, "mach-sdl-shot.jpg", 90);
    if (sel jpg_saved.err) {
        print.eprint("screenshot: save_jpg failed: ");
        print.eprintln(error.message());
    }
    surface.destroy(grabbed.ok);
    if (sel png_saved.err) { ret none; }

    val png_kind: res[image.Format, error.Error] = image.detect("mach-sdl-shot.png");
    if (sel png_kind.ok) { print.printf("screenshot: mach-sdl-shot.png is {}\n", image.format_name(png_kind.ok)); }
    val jpg_kind: res[image.Format, error.Error] = image.detect("mach-sdl-shot.jpg");
    if (sel jpg_kind.ok) { print.printf("screenshot: mach-sdl-shot.jpg is {}\n", image.format_name(jpg_kind.ok)); }
    val jpg_back: res[surface.Surface, error.Error] = image.load("mach-sdl-shot.jpg");
    if (sel jpg_back.ok) {
        print.println("screenshot: jpg loads back ok");
        surface.destroy(jpg_back.ok);
    } or {
        print.eprint("screenshot: jpg reload failed: ");
        print.eprintln(error.message());
    }

    val back: res[texture.Texture, error.Error] = image.load_texture(rend, "mach-sdl-shot.png");
    if (sel back.ok) {
        val sz: res[texture.Size, error.Error] = texture.size(back.ok);
        if (sel sz.ok) { print.printf("screenshot: png loads back as {}x{}\n", sz.ok.w::i64, sz.ok.h::i64); }
        ret back.ok;
    }
    print.eprint("screenshot: png reload failed: ");
    print.eprintln(error.message());
    ret none;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val started: err[error.Error] = core.init(core.VIDEO | core.AUDIO);
    if (sel started.err) {
        ret fail("SDL_Init failed");
    }

    # a different seed each run, so the collectible lands somewhere new
    rand.seed(timer.ticks_ns());

    # --- main window: OpenGL ---
    val made_main: res[window.Window, error.Error] = window.create("mach-sdl demo", 800, 600, window.OPENGL | window.RESIZABLE);
    if (sel made_main.err) {
        val r: i64 = fail("window.create failed");
        core.quit();
        ret r;
    }
    val main_win: window.Window = made_main.ok;

    val made_ctx: res[gl.GlContext, error.Error] = gl.create_context(main_win);
    if (sel made_ctx.err) {
        val r: i64 = fail("GL context failed");
        window.destroy(main_win);
        core.quit();
        ret r;
    }
    val ctx: gl.GlContext = made_ctx.ok;

    val clear_color: GlClearColorFun   = load_gl("glClearColor"):~GlClearColorFun;
    val clear_gl:    GlClearFun        = load_gl("glClear"):~GlClearFun;
    val viewport:    GlViewportFun     = load_gl("glViewport"):~GlViewportFun;
    val matrix_mode: GlMatrixModeFun   = load_gl("glMatrixMode"):~GlMatrixModeFun;
    val load_id:     GlLoadIdentityFun = load_gl("glLoadIdentity"):~GlLoadIdentityFun;
    val ortho:       GlOrthoFun        = load_gl("glOrtho"):~GlOrthoFun;
    val gl_begin:    GlBeginFun        = load_gl("glBegin"):~GlBeginFun;
    val gl_end:      GlEndFun          = load_gl("glEnd"):~GlEndFun;
    val vertex2f:    GlVertex2fFun     = load_gl("glVertex2f"):~GlVertex2fFun;
    val color3f:     GlColor3fFun      = load_gl("glColor3f"):~GlColor3fFun;
    if (clear_color == nil || clear_gl == nil || viewport == nil || matrix_mode == nil
        || load_id == nil || ortho == nil || gl_begin == nil || gl_end == nil
        || vertex2f == nil || color3f == nil) {
        print.eprintln("failed to load GL functions");
        gl.destroy_context(ctx);
        window.destroy(main_win);
        core.quit();
        ret 1;
    }

    var win_w: f32 = 800.0;
    var win_h: f32 = 600.0;
    viewport(0, 0, win_w::i32, win_h::i32);
    matrix_mode(GL_PROJECTION);
    load_id();
    ortho(0.0, win_w::f64, win_h::f64, 0.0, -1.0, 1.0);
    matrix_mode(GL_MODELVIEW);

    # --- second window: SDL renderer ---
    val made_second: res[window.Window, error.Error] = window.create("renderer view", 300, 300, 0);
    if (sel made_second.err) {
        val r: i64 = fail("second window failed");
        gl.destroy_context(ctx);
        window.destroy(main_win);
        core.quit();
        ret r;
    }
    val rend_win: window.Window = made_second.ok;
    window.set_title(rend_win, "mach-sdl: renderer window");

    val made_rend: res[renderer.Renderer, error.Error] = renderer.create(rend_win);
    if (sel made_rend.err) {
        val r: i64 = fail("renderer.create failed");
        window.destroy(rend_win);
        gl.destroy_context(ctx);
        window.destroy(main_win);
        core.quit();
        ret r;
    }
    val rend: renderer.Renderer = made_rend.ok;

    # there is no BMP on disk, so this must fail cleanly: it exercises the
    # error path of texture.load without needing an asset
    val test_tex: res[texture.Texture, error.Error] = texture.load(rend, "nonexistent.bmp");
    if (sel test_tex.err) {
        print.println("texture load (expected failure): ok, no crash, error reported cleanly");
    }
    if (sel test_tex.ok) {
        texture.destroy(test_tex.ok);
    }

    # --- audio ---
    var beep_stream: audio.Stream;
    var have_audio: bool = false;
    val opened_audio: res[audio.Stream, error.Error] = audio.open(audio.Format.s16{}, 1, 8000);
    if (sel opened_audio.ok) {
        beep_stream = opened_audio.ok;
        have_audio = true;
        audio.resume(beep_stream);
        print.println("audio: stream open");
    } or {
        print.println("audio device unavailable, SPACE will be silent");
    }
    var beep: [2400]u8;
    fill_beep(?beep[0]);

    # --- images (SDL3_image) ---
    print.printf("SDL3_image version: {}\n", image.version());

    # no such file, so this must fail cleanly: the error path of image.load_texture
    val bad_img: res[texture.Texture, error.Error] = image.load_texture(rend, "nonexistent.png");
    if (sel bad_img.err) {
        print.println("image load (expected failure): ok, no crash, error reported cleanly");
    }
    if (sel bad_img.ok) {
        texture.destroy(bad_img.ok);
    }

    var anim:       image.Animation  = image.Animation{ handle: nil };
    var anim_tex:   renderer.Texture = renderer.Texture{ handle: nil };
    var anim_w:     f32 = 0.0;
    var anim_h:     f32 = 0.0;
    var anim_count: i32 = 0;
    var anim_index: i32 = 0;
    var anim_delay: i32 = 100;
    var anim_wait:  f64 = 0.0;
    var shot_tex:   renderer.Texture = renderer.Texture{ handle: nil };
    var want_shot:  bool = false;

    if (argc > 2) {
        val kind: res[image.Format, error.Error] = image.detect(argv[2]);
        if (sel kind.ok) {
            print.printf("image format: {}\n", image.format_name(kind.ok));
        } or {
            print.eprint("image detect failed: ");
            print.eprintln(error.message());
        }

        val loaded: res[image.Animation, error.Error] = image.load_animation(argv[2]);
        if (sel loaded.ok) {
            anim = loaded.ok;
            val info: res[image.AnimationInfo, error.Error] = image.animation_info(anim);
            if (sel info.ok) {
                anim_w = info.ok.w::f32;
                anim_h = info.ok.h::f32;
                anim_count = info.ok.count;
                print.printf("image: {}x{}, {} frame(s)\n", info.ok.w, info.ok.h, info.ok.count);
            }
            anim_tex = frame_texture(rend, anim, 0);
            val d0: res[i32, error.Error] = image.animation_delay(anim, 0);
            if (sel d0.ok) {
                anim_delay = d0.ok;
                if (anim_delay < 10) { anim_delay = 10; }
            }
        } or {
            print.eprint("image load failed: ");
            print.eprintln(error.message());
        }
    } or {
        print.println("(pass an image file as the second argument)");
    }

    # --- text (SDL3_ttf) ---
    var have_ttf:  bool = false;
    var have_font: bool = false;
    var fnt: font.Font = font.Font{ handle: nil };
    var score_tex: renderer.Texture = renderer.Texture{ handle: nil };
    var help_tex:  renderer.Texture = renderer.Texture{ handle: nil };
    var score_buf: [32]u8;
    var score_w: f32 = 0.0;
    var score_h: f32 = 0.0;
    var help_w:  f32 = 0.0;
    var help_h:  f32 = 0.0;
    var shown_score: i64 = 0 - 1;

    val ttf_started: err[error.Error] = font.init();
    if (sel ttf_started.ok) {
        have_ttf = true;
        print.printf("SDL3_ttf version: {}\n", font.version());

        # no such file, so this must fail cleanly: the error path of font.open
        val bad_font: res[font.Font, error.Error] = font.open("nonexistent.ttf", 16.0);
        if (sel bad_font.err) {
            print.println("font open (expected failure): ok, no crash, error reported cleanly");
        }
        if (sel bad_font.ok) {
            font.close(bad_font.ok);
        }

        var font_res: res[font.Font, error.Error];
        if (argc > 1 && argv[1][0] != 45) {
            font_res = font.open(argv[1], 20.0);
        } or {
            font_res = open_any_font(20.0);
        }

        if (sel font_res.ok) {
            fnt = font_res.ok;
            have_font = true;

            val family: res[str, error.Error] = font.family_name(fnt);
            if (sel family.ok) { print.printf("font: {}\n", family.ok); }
            val line_h: res[i32, error.Error] = font.height(fnt);
            if (sel line_h.ok) { print.printf("font height: {}px\n", line_h.ok); }
            val probe: res[font.TextSize, error.Error] = font.measure(fnt, "mach-sdl");
            if (sel probe.ok) { print.printf("measure \"mach-sdl\": {}x{}\n", probe.ok.w, probe.ok.h); }

            # static two-line help label, rendered once (newlines only wrap)
            val help: res[texture.Texture, error.Error] = font.render_texture_wrapped(rend, fnt, "WASD to move\nESC to quit", color_of(180, 180, 200, 255), 0);
            if (sel help.ok) {
                help_tex = help.ok;
                val hs: res[texture.Size, error.Error] = texture.size(help_tex);
                if (sel hs.ok) {
                    help_w = hs.ok.w;
                    help_h = hs.ok.h;
                }
            } or {
                print.eprint("help label failed: ");
                print.eprintln(error.message());
            }

            # the live score label is bold
            font.set_style(fnt, font.STYLE_BOLD);
        } or {
            print.eprint("font unavailable, running without text: ");
            print.eprintln(error.message());
            print.println("(pass a .ttf path as the first argument)");
        }
    } or {
        print.eprint("font.init failed, running without text: ");
        print.eprintln(error.message());
    }

    # --- collectible (rect + rand) ---
    var collectible: rect.FRect = spawn_collectible(win_w, win_h);
    var score: i64 = 0;

    print.println("");
    print.println("WASD=move  SPACE=beep  M=cursor  F=fullscreen  ESC=quit");
    print.println("L=relative mouse  N=minimize renderer window  C=copy clipboard  V=paste clipboard");
    print.println("P=screenshot of the renderer window (mach-sdl-shot.png / .jpg)");
    print.println("collect the green square to score a point");
    print.println("");

    var px: f32 = win_w / 2.0;
    var py: f32 = win_h / 2.0;
    var move_up:    u8 = 0;
    var move_down:  u8 = 0;
    var move_left:  u8 = 0;
    var move_right: u8 = 0;
    var cursor_hidden: bool = false;
    var fullscreen:    bool = false;
    var relative_mode: bool = false;
    var rend_win_minimized: bool = false;

    var clk: timer.Clock = timer.clock();
    var print_accum: f64 = 0.0;
    var running: u8 = 1;

    for (running != 0) {
        for (true) {
            val next: opt[event.Event] = event.poll();
            if (!sel next.some) { brk; }
            val ev: event.Event = next.some;

            if (sel ev.quit) {
                running = 0;
            }

            if (sel ev.key_down) {
                val kd: event.KeyEvent = ev.key_down;
                val fresh: bool = !kd.repeat;

                if (kd.scancode == key.ESCAPE) {
                    running = 0;
                }
                or (kd.scancode == key.W) { move_up = 1; }
                or (kd.scancode == key.S) { move_down = 1; }
                or (kd.scancode == key.A) { move_left = 1; }
                or (kd.scancode == key.D) { move_right = 1; }
                or (kd.scancode == key.F && fresh) {
                    fullscreen = !fullscreen;
                    window.set_fullscreen(main_win, fullscreen);
                }
                or (kd.scancode == key.M && fresh) {
                    if (cursor_hidden) {
                        mouse.show_cursor();
                        cursor_hidden = false;
                        print.println("cursor: visible");
                    } or {
                        mouse.hide_cursor();
                        cursor_hidden = true;
                        print.println("cursor: hidden");
                    }
                }
                or (kd.scancode == key.SPACE && fresh) {
                    if (have_audio) {
                        audio.put(beep_stream, ?beep[0], 2400);
                    }
                }
                or (kd.scancode == key.L && fresh) {
                    relative_mode = !relative_mode;
                    mouse.set_relative(main_win, relative_mode);
                    if (relative_mode) {
                        print.println("mouse: relative mode on");
                    } or {
                        print.println("mouse: relative mode off");
                    }
                }
                or (kd.scancode == key.N && fresh) {
                    if (rend_win_minimized) {
                        window.restore(rend_win);
                        rend_win_minimized = false;
                        print.println("renderer window: restored");
                    } or {
                        window.minimize(rend_win);
                        rend_win_minimized = true;
                        print.println("renderer window: minimized");
                    }
                }
                or (kd.scancode == key.C && fresh) {
                    clipboard.set_text("mach-sdl clipboard demo");
                    print.println("clipboard: copied demo string");
                }
                or (kd.scancode == key.P && fresh) {
                    want_shot = true;
                }
                or (kd.scancode == key.V && fresh) {
                    val pasted: res[str, error.Error] = clipboard.text();
                    if (sel pasted.ok) {
                        print.printf("clipboard: {}\n", pasted.ok);
                        clipboard.free_text(pasted.ok);
                    } or {
                        print.println("clipboard: could not read text");
                    }
                }
            }

            if (sel ev.key_up) {
                val ku: event.KeyEvent = ev.key_up;
                if (ku.scancode == key.W) { move_up = 0; }
                or (ku.scancode == key.S) { move_down = 0; }
                or (ku.scancode == key.A) { move_left = 0; }
                or (ku.scancode == key.D) { move_right = 0; }
            }

            if (sel ev.mouse_button_down) {
                val mb: event.MouseButton = ev.mouse_button_down;
                print.printf("mouse btn {} at ({}, {})\n", mb.button, mb.x::i64, mb.y::i64);
            }

            if (sel ev.mouse_wheel) {
                val mw: event.MouseWheel = ev.mouse_wheel;
                print.printf("mouse wheel x={} y={}\n", mw.dx::i64, mw.dy::i64);
            }

            if (sel ev.window_resized) {
                val we: event.WindowEvent = ev.window_resized;
                win_w = we.width::f32;
                win_h = we.height::f32;
                viewport(0, 0, we.width, we.height);
                matrix_mode(GL_PROJECTION);
                load_id();
                ortho(0.0, win_w::f64, win_h::f64, 0.0, -1.0, 1.0);
                matrix_mode(GL_MODELVIEW);
                collectible = spawn_collectible(win_w, win_h);
                print.printf("window resized: {}x{}\n", we.width, we.height);
            }
        }

        val dt: f64 = timer.tick(?clk);
        val dist: f32 = MOVE_SPEED * (dt::f32);

        if (move_up    != 0) { py = py - dist; }
        if (move_down  != 0) { py = py + dist; }
        if (move_left  != 0) { px = px - dist; }
        if (move_right != 0) { px = px + dist; }

        if (px < HALF) { px = HALF; }
        if (py < HALF) { py = HALF; }
        if (px > win_w - HALF) { px = win_w - HALF; }
        if (py > win_h - HALF) { py = win_h - HALF; }

        val cursor: mouse.State = mouse.state();
        val mx: f32 = cursor.x;
        val my: f32 = cursor.y;

        # collectible collision through rect.intersects
        val player_rect: rect.FRect = rect.FRect{ x: px - HALF, y: py - HALF, w: HALF * 2.0, h: HALF * 2.0 };
        if (rect.intersects(player_rect, collectible)) {
            score = score + 1;
            print.printf("collected! score: {}\n", score);
            collectible = spawn_collectible(win_w, win_h);
        }

        # re-render the score label only when the score changes
        if (have_font && shown_score != score) {
            format_score(?score_buf[0], score);
            val made: res[texture.Texture, error.Error] = font.render_texture(rend, fnt, ?score_buf[0], color_of(255, 255, 255, 255));
            if (sel made.ok) {
                texture.destroy(score_tex);
                score_tex = made.ok;
                val ss: res[texture.Size, error.Error] = texture.size(score_tex);
                if (sel ss.ok) {
                    score_w = ss.ok.w;
                    score_h = ss.ok.h;
                }
            } or {
                print.eprint("score label failed: ");
                print.eprintln(error.message());
            }
            shown_score = score;
        }

        # step the animation by wall time
        if (anim_count > 1) {
            anim_wait = anim_wait + dt * 1000.0;
            if (anim_wait >= (anim_delay::f64)) {
                anim_wait = 0.0;
                anim_index = (anim_index + 1) % anim_count;
                val next_tex: renderer.Texture = frame_texture(rend, anim, anim_index);
                if (texture.is_valid(next_tex)) {
                    texture.destroy(anim_tex);
                    anim_tex = next_tex;
                }
                val dn: res[i32, error.Error] = image.animation_delay(anim, anim_index);
                if (sel dn.ok) {
                    anim_delay = dn.ok;
                    if (anim_delay < 10) { anim_delay = 10; }
                }
            }
        }

        print_accum = print_accum + dt;
        if (print_accum >= 2.0) {
            val sz: res[window.Size, error.Error] = window.size(main_win);
            if (sel sz.ok) {
                print.printf("pos=({},{}) mouse=({},{}) size={}x{} score={}\n",
                    px::i64, py::i64, mx::i64, my::i64, sz.ok.w, sz.ok.h, score);
            }
            print_accum = 0.0;
        }

        # --- draw: main GL window ---
        clear_color(0.10, 0.10, 0.14, 1.0);
        clear_gl(GL_COLOR_BUFFER_BIT);

        # collectible: green
        draw_square(gl_begin, gl_end, vertex2f, color3f,
                    collectible.x + HALF, collectible.y + HALF,
                    0.2, 0.9, 0.3);

        # player: orange
        draw_square(gl_begin, gl_end, vertex2f, color3f,
                    px, py, 0.9, 0.4, 0.2);

        # mouse position: a tiny 4px square following the cursor
        color3f(0.5, 0.5, 0.8);
        gl_begin(GL_QUADS);
        vertex2f(mx - 2.0, my - 2.0);
        vertex2f(mx + 2.0, my - 2.0);
        vertex2f(mx + 2.0, my + 2.0);
        vertex2f(mx - 2.0, my + 2.0);
        gl_end();

        gl.swap(main_win);

        # --- draw: renderer window (a scaled-down copy of the same scene) ---
        renderer.set_color(rend, color_of(15, 15, 22, 255));
        renderer.clear(rend);

        val scale_x: f32 = 280.0 / win_w;
        val scale_y: f32 = 280.0 / win_h;

        # collectible in the renderer window
        val coll_scaled: rect.FRect = rect.FRect{
            x: (collectible.x + HALF) * scale_x - HALF * 0.4,
            y: (collectible.y + HALF) * scale_y - HALF * 0.4,
            w: HALF * 0.8,
            h: HALF * 0.8
        };
        renderer.set_color(rend, color_of(50, 230, 80, 255));
        renderer.fill_rect(rend, coll_scaled);

        # player in the renderer window
        val player_scaled: rect.FRect = rect.FRect{
            x: px * scale_x - HALF * 0.4,
            y: py * scale_y - HALF * 0.4,
            w: HALF * 0.8,
            h: HALF * 0.8
        };
        renderer.set_color(rend, color_of(230, 100, 50, 255));
        renderer.fill_rect(rend, player_scaled);

        # border outline (draw_rect)
        val border: rect.FRect = rect.FRect{ x: 1.0, y: 1.0, w: 278.0, h: 278.0 };
        renderer.set_color(rend, color_of(80, 80, 120, 255));
        renderer.draw_rect(rend, border);

        # translucent halo behind the collectible (set_blend)
        renderer.set_blend(rend, renderer.Blend.blend{});
        val halo: rect.FRect = rect.FRect{
            x: coll_scaled.x - 4.0, y: coll_scaled.y - 4.0,
            w: coll_scaled.w + 8.0, h: coll_scaled.h + 8.0
        };
        renderer.set_color(rend, color_of(50, 230, 80, 90));
        renderer.fill_rect(rend, halo);
        renderer.set_blend(rend, renderer.Blend.none{});

        # a corner starfield and a connecting line, clipped to the top-left
        # quadrant (set_clip, draw_points, draw_lines, clear_clip)
        val star_clip: rect.Rect = rect.Rect{ x: 0, y: 0, w: 140, h: 140 };
        renderer.set_clip(rend, star_clip);

        var star_points: [5]rect.FPoint;
        star_points[0] = rect.FPoint{ x: 10.0, y: 10.0 };
        star_points[1] = rect.FPoint{ x: 15.0, y: 25.0 };
        star_points[2] = rect.FPoint{ x: 22.0, y: 12.0 };
        star_points[3] = rect.FPoint{ x: 30.0, y: 28.0 };
        star_points[4] = rect.FPoint{ x: 35.0, y: 15.0 };
        renderer.set_color(rend, color_of(255, 255, 255, 255));
        renderer.draw_points(rend, ?star_points[0], 5);
        renderer.set_color(rend, color_of(120, 180, 255, 255));
        renderer.draw_lines(rend, ?star_points[0], 5);

        renderer.clear_clip(rend);

        # tick marks along the bottom edge (fill_rects)
        var tick_rects: [3]rect.FRect;
        tick_rects[0] = rect.FRect{ x: 20.0, y: 268.0, w: 4.0, h: 8.0 };
        tick_rects[1] = rect.FRect{ x: 40.0, y: 268.0, w: 4.0, h: 8.0 };
        tick_rects[2] = rect.FRect{ x: 60.0, y: 268.0, w: 4.0, h: 8.0 };
        renderer.set_color(rend, color_of(255, 200, 60, 255));
        renderer.fill_rects(rend, ?tick_rects[0], 3);

        # text labels (font): score top right, help below it
        if (texture.is_valid(score_tex)) {
            renderer.draw_texture(rend, score_tex, rect.FRect{ x: 150.0, y: 8.0, w: score_w, h: score_h });
        }
        if (texture.is_valid(help_tex)) {
            renderer.draw_texture(rend, help_tex, rect.FRect{ x: 150.0, y: 40.0, w: help_w, h: help_h });
        }

        # images: the loaded image or animation, and the last screenshot thumbnail
        if (texture.is_valid(anim_tex)) {
            renderer.draw_texture(rend, anim_tex, fit(anim_w, anim_h, 120.0, 165.0, 135.0));
        }
        if (texture.is_valid(shot_tex)) {
            renderer.draw_texture(rend, shot_tex, rect.FRect{ x: 20.0, y: 160.0, w: 100.0, h: 100.0 });
        }

        if (want_shot) {
            want_shot = false;
            val shot: renderer.Texture = screenshot(rend);
            if (texture.is_valid(shot)) {
                texture.destroy(shot_tex);
                shot_tex = shot;
            }
        }

        renderer.present(rend);
    }

    # message box on exit: it blocks until OK, which shows blocking works
    msgbox.show(msgbox.Kind.info{}, "mach-sdl demo", "clean shutdown. all modules exercised.", window.Window{ handle: nil });

    if (relative_mode) { mouse.set_relative(main_win, false); }
    if (have_audio)    { audio.close(beep_stream); }
    texture.destroy(score_tex);
    texture.destroy(help_tex);
    texture.destroy(anim_tex);
    texture.destroy(shot_tex);
    image.destroy_animation(anim);
    font.close(fnt);
    if (have_ttf)      { font.quit(); }
    renderer.destroy(rend);
    window.destroy(rend_win);
    gl.destroy_context(ctx);
    window.destroy(main_win);
    core.quit();
    print.println("clean shutdown, bye");
    ret 0;
}
