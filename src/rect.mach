# points and rectangles (sdl.rect)
#
# plain value records for positions and areas. the renderer draws with the
# float versions (FPoint, FRect); renderer.set_clip takes an integer Rect.
# all of them can be built with a literal, e.g.
# FRect{ x: 10.0, y: 20.0, w: 64.0, h: 64.0 }.

use sdl.c;
use std.types.bool.bool;
use std.types.option.opt;

# an integer point
# ---
# x: horizontal position
# y: vertical position
pub rec Point {
    x: i32;
    y: i32;
}

# a float point
# ---
# x: horizontal position
# y: vertical position
pub rec FPoint {
    x: f32;
    y: f32;
}

# an integer rectangle
# ---
# x, y: top-left corner
# w, h: width and height
pub rec Rect {
    x: i32;
    y: i32;
    w: i32;
    h: i32;
}

# a float rectangle
# ---
# x, y: top-left corner
# w, h: width and height
pub rec FRect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

# whether two rectangles overlap
# ---
# a: first rectangle
# b: second rectangle
# ret: true if they share any area
pub fun intersects(a: FRect, b: FRect) bool {
    ret c.SDL_HasRectIntersectionFloat((?a)::*c.FRect, (?b)::*c.FRect) != 0;
}

# the overlapping region of two rectangles
# ---
# a: first rectangle
# b: second rectangle
# ret: the shared area, or none when they do not overlap
pub fun intersection(a: FRect, b: FRect) opt[FRect] {
    var result: FRect = FRect{ x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    if (c.SDL_GetRectIntersectionFloat((?a)::*c.FRect, (?b)::*c.FRect, (?result)::*c.FRect) == 0) {
        ret opt[FRect].none{};
    }
    ret opt[FRect].some{ result };
}

# whether a point lies inside a rectangle. the left and top edges count as
# inside, the right and bottom edges as outside, so two rectangles that
# share an edge never both contain a point on it. (SDL's own
# SDL_PointInRectFloat counts all four edges as inside.)
# ---
# r: rectangle to test against
# p: point to test
# ret: true if the point is inside
pub fun contains(r: FRect, p: FPoint) bool {
    ret p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;
}

test rect__point_layout {
    if ($size_of(Point) != 8) { ret 1; }
    ret 0;
}

test rect__fpoint_layout {
    if ($size_of(FPoint) != 8) { ret 1; }
    ret 0;
}

test rect__rect_layout {
    if ($size_of(Rect) != 16) { ret 1; }
    ret 0;
}

test rect__frect_layout {
    if ($size_of(FRect) != 16) { ret 1; }
    ret 0;
}

test rect__intersects_detects_overlap {
    val a: FRect = FRect{ x: 0.0, y: 0.0, w: 10.0, h: 10.0 };
    val b: FRect = FRect{ x: 5.0, y: 5.0, w: 10.0, h: 10.0 };
    val far: FRect = FRect{ x: 100.0, y: 100.0, w: 10.0, h: 10.0 };
    if (!intersects(a, b)) { ret 1; }
    if (intersects(a, far)) { ret 1; }
    ret 0;
}

test rect__intersection_is_none_without_overlap {
    val a: FRect = FRect{ x: 0.0, y: 0.0, w: 10.0, h: 10.0 };
    val far: FRect = FRect{ x: 100.0, y: 100.0, w: 10.0, h: 10.0 };
    val r: opt[FRect] = intersection(a, far);
    if (sel r.some) { ret 1; }
    ret 0;
}

test rect__contains_includes_near_edge_excludes_far_edge {
    val r: FRect = FRect{ x: 0.0, y: 0.0, w: 10.0, h: 10.0 };
    if (!contains(r, FPoint{ x: 0.0, y: 0.0 })) { ret 1; }
    if (contains(r, FPoint{ x: 10.0, y: 10.0 })) { ret 1; }
    if (contains(r, FPoint{ x: -1.0, y: 5.0 })) { ret 1; }
    ret 0;
}
