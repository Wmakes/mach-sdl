# mouse buttons, position, cursor and capture (sdl.mouse)
#
# state() and relative_state() return a bitmask of held buttons; test one
# button with held():
#
# ```mach
# val st: mouse.State = mouse.state();
# if (mouse.held(st.buttons, mouse.LEFT)) { ... }
# ```

use sdl.c;
use sdl.error;
use sdl.window;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;

# the left button
pub val LEFT:   u8 = c.BUTTON_LEFT;
# the middle button (wheel click)
pub val MIDDLE: u8 = c.BUTTON_MIDDLE;
# the right button
pub val RIGHT:  u8 = c.BUTTON_RIGHT;
# the first extra button (usually "back")
pub val X1:     u8 = c.BUTTON_X1;
# the second extra button (usually "forward")
pub val X2:     u8 = c.BUTTON_X2;

# mouse position and held buttons
# ---
# x, y:    position in window coordinates, or motion deltas from relative_state()
# buttons: bitmask of held buttons, test with held()
pub rec State {
    x:       f32;
    y:       f32;
    buttons: u32;
}

# whether a button is set in a button bitmask
# ---
# buttons: a bitmask from State.buttons or MouseMotion.buttons
# button:  LEFT, MIDDLE, RIGHT, X1 or X2
# ret:     true if that button is held
pub fun held(buttons: u32, button: u8) bool {
    if (button == 0 || button > 32) {
        ret false;
    }
    val bit: u32 = 1::u32 << ((button - 1)::u32);
    ret (buttons & bit) != 0;
}

# turn an SDL bool result into err[error.Error]
# ---
# succeeded: the u8 result of an SDL call, nonzero on success
fun to_err(succeeded: u8) err[error.Error] {
    if (succeeded == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# reject a nil window handle before SDL is called
# ---
# win: window the caller is about to use
fun ready(win: window.Window) err[error.Error] {
    if (!window.is_valid(win)) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    ret err[error.Error].ok{};
}

# the mouse position relative to the focused window, and held buttons
# ---
# ret: position in window coordinates and the button bitmask
pub fun state() State {
    var x: f32 = 0.0;
    var y: f32 = 0.0;
    val buttons: u32 = c.SDL_GetMouseState(?x, ?y);
    ret State{ x: x, y: y, buttons: buttons };
}

# the mouse motion accumulated since the last call, and held buttons. the
# usual way to read camera-look input while relative mode is on (see
# set_relative)
# ---
# ret: x, y hold the motion deltas, plus the button bitmask
pub fun relative_state() State {
    var dx: f32 = 0.0;
    var dy: f32 = 0.0;
    val buttons: u32 = c.SDL_GetRelativeMouseState(?dx, ?dy);
    ret State{ x: dx, y: dy, buttons: buttons };
}

# move the cursor to a position inside a window. does nothing for an
# invalid window
# ---
# win: window to move the cursor within
# x, y: target position in window coordinates
pub fun warp(win: window.Window, x: f32, y: f32) {
    if (window.is_valid(win)) {
        c.SDL_WarpMouseInWindow(win.handle, x, y);
    }
}

# show the system cursor
pub fun show_cursor() err[error.Error] {
    ret to_err(c.SDL_ShowCursor());
}

# hide the system cursor
pub fun hide_cursor() err[error.Error] {
    ret to_err(c.SDL_HideCursor());
}

# hide and confine the cursor to a window, and report only motion deltas
# (see relative_state). the usual pattern for camera-look controls
# ---
# win: window to apply relative mode to
# on:  true to enter relative mode, false to leave it
pub fun set_relative(win: window.Window, on: bool) err[error.Error] {
    val r: err[error.Error] = ready(win);
    if (!sel r.ok) { ret r; }
    ret to_err(c.SDL_SetWindowRelativeMouseMode(win.handle, on));
}

# whether relative mode is on for a window
# ---
# win: window to query
# ret: true if relative mode is on; false for an invalid window
pub fun is_relative(win: window.Window) bool {
    if (!window.is_valid(win)) {
        ret false;
    }
    ret c.SDL_GetWindowRelativeMouseMode(win.handle) != 0;
}

# keep receiving mouse events while a button is held, even outside the
# window. the cursor stays visible, unlike in relative mode
# ---
# on: true to start capturing, false to release
pub fun capture(on: bool) err[error.Error] {
    ret to_err(c.SDL_CaptureMouse(on));
}
