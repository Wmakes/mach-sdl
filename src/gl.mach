# OpenGL context management (sdl.gl)
#
# create the window with window.OPENGL, then create_context makes a GL
# context and makes it current. each frame, draw with GL and call swap.
#
# this binding does not include GL itself. load each GL function with
# proc_address and reinterpret the address as a function type with `:~`.
#
# use a GlContext or sdl.renderer for a given window, not both. the dummy
# video driver (core.use_dummy_video) cannot create GL contexts.

use sdl.c;
use sdl.error;
use sdl.window;
use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

# handle to an SDL GL context. the zero value (nil handle) is invalid
# ---
# handle: opaque SDL_GLContext pointer, nil when invalid
pub rec GlContext {
    handle: ptr;
}

# whether a GlContext holds a live handle
# ---
# ctx: context to test
# ret: true if the handle is non-nil
pub fun is_valid(ctx: GlContext) bool {
    ret ctx.handle != nil;
}

# create a GL context for a window and make it current
# ---
# win: window created with window.OPENGL
# ret: the new GlContext, or error.Error.invalid for a nil window, or
#      error.Error.failed (text from error.message())
pub fun create_context(win: window.Window) res[GlContext, error.Error] {
    if (!window.is_valid(win)) {
        ret res[GlContext, error.Error].err{ error.Error.invalid{} };
    }
    val handle: ptr = c.SDL_GL_CreateContext(win.handle);
    if (handle == nil) {
        ret res[GlContext, error.Error].err{ error.Error.failed{} };
    }
    if (c.SDL_GL_MakeCurrent(win.handle, handle) == 0) {
        c.SDL_GL_DestroyContext(handle);
        ret res[GlContext, error.Error].err{ error.Error.failed{} };
    }
    ret res[GlContext, error.Error].ok{ GlContext{ handle: handle } };
}

# destroy a GL context. safe on an invalid handle
# ---
# ctx: context to destroy
pub fun destroy_context(ctx: GlContext) {
    if (is_valid(ctx)) {
        c.SDL_GL_DestroyContext(ctx.handle);
    }
}

# present the back buffer of a window whose GL context is current
# ---
# win: window to swap
pub fun swap(win: window.Window) err[error.Error] {
    if (!window.is_valid(win)) {
        ret err[error.Error].err{ error.Error.invalid{} };
    }
    if (c.SDL_GL_SwapWindow(win.handle) == 0) {
        ret err[error.Error].err{ error.Error.failed{} };
    }
    ret err[error.Error].ok{};
}

# the address of a GL function for the current context. reinterpret it with
# `:~` as the matching function type before calling
# ---
# name: function name, for example "glClearColor"
# ret:  the function address, or none if the function is not found
pub fun proc_address(name: str) opt[ptr] {
    val addr: ptr = c.SDL_GL_GetProcAddress(name);
    if (addr == nil) {
        ret opt[ptr].none{};
    }
    ret opt[ptr].some{ addr };
}
