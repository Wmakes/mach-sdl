# the flat public surface of the mach-sdl bindings
#
# re-exports everything under one namespace so consumers can write
# `use sdl: sdl.sdl;` and reach the whole API as sdl.init(),
# sdl.open_gl_window(), sdl.poll_event(), sdl.new_clock(), etc.
# the split modules (sdl.core, sdl.window, ...) remain importable
# individually for a smaller dependency surface if you don't need
# the whole thing.

use sdl.c;
use sdl.core;
use sdl.window;
use sdl.events;
use sdl.key;
use sdl.gl;
use sdl.mouse;
use sdl.timer;
use sdl.gamepad;
use sdl.renderer;
use sdl.audio;
use sdl.rect;
use sdl.rand;
use sdl.msgbox;

# --- raw types (re-exported so consumers don't need to import sdl.c) ---
fwd c.Event;
fwd c.KeyboardEvent;
fwd c.WindowEvent;
fwd c.MouseMotionEvent;
fwd c.MouseButtonEvent;
fwd c.MouseWheelEvent;
fwd c.FRect;
fwd c.AudioSpec;

# --- core ---
fwd core.INIT_VIDEO;
fwd core.INIT_AUDIO;
fwd core.INIT_EVENTS;
fwd core.init;
fwd core.quit;
fwd core.get_error;
fwd core.use_dummy_video_driver;
fwd core.use_dummy_audio_driver;

# --- window ---
fwd window.Window;
fwd window.Size;
fwd window.WINDOW_OPENGL;
fwd window.WINDOW_RESIZABLE;
fwd window.window_is_valid;
fwd window.create_window;
fwd window.open_gl_window;
fwd window.destroy_window;
fwd window.set_title;
fwd window.get_size;
fwd window.set_position;
fwd window.set_fullscreen;

# --- events ---
fwd events.EVENT_QUIT;
fwd events.EVENT_KEY_DOWN;
fwd events.EVENT_KEY_UP;
fwd events.EVENT_WINDOW_RESIZED;
fwd events.EVENT_WINDOW_FOCUS_GAINED;
fwd events.EVENT_WINDOW_FOCUS_LOST;
fwd events.EVENT_WINDOW_CLOSE_REQUESTED;
fwd events.EVENT_MOUSE_MOTION;
fwd events.EVENT_MOUSE_BUTTON_DOWN;
fwd events.EVENT_MOUSE_BUTTON_UP;
fwd events.EVENT_MOUSE_WHEEL;
fwd events.poll_event;
fwd events.event_type;
fwd events.as_keyboard;
fwd events.as_window;
fwd events.as_mouse_motion;
fwd events.as_mouse_button;
fwd events.as_mouse_wheel;
fwd events.key_is_fresh_press;

# --- key scancodes ---
fwd key.A; fwd key.B; fwd key.C; fwd key.D; fwd key.E; fwd key.F;
fwd key.G; fwd key.H; fwd key.I; fwd key.J; fwd key.K; fwd key.L;
fwd key.M; fwd key.N; fwd key.O; fwd key.P; fwd key.Q; fwd key.R;
fwd key.S; fwd key.T; fwd key.U; fwd key.V; fwd key.W; fwd key.X;
fwd key.Y; fwd key.Z;
fwd key.NUM_0; fwd key.NUM_1; fwd key.NUM_2; fwd key.NUM_3;
fwd key.NUM_4; fwd key.NUM_5; fwd key.NUM_6; fwd key.NUM_7;
fwd key.NUM_8; fwd key.NUM_9;
fwd key.RETURN; fwd key.ESCAPE; fwd key.BACKSPACE;
fwd key.TAB; fwd key.SPACE;
fwd key.F1; fwd key.F2; fwd key.F3; fwd key.F4; fwd key.F5; fwd key.F6;
fwd key.F7; fwd key.F8; fwd key.F9; fwd key.F10; fwd key.F11; fwd key.F12;
fwd key.RIGHT; fwd key.LEFT; fwd key.DOWN; fwd key.UP;
fwd key.LCTRL; fwd key.LSHIFT; fwd key.LALT;
fwd key.RCTRL; fwd key.RSHIFT; fwd key.RALT;

# --- gl ---
fwd gl.create_context;
fwd gl.destroy_context;
fwd gl.swap_window;
fwd gl.get_proc_address;

# --- mouse ---
fwd mouse.BUTTON_LEFT; fwd mouse.BUTTON_MIDDLE; fwd mouse.BUTTON_RIGHT;
