# --- gamepad ---
fwd gamepad.Gamepad;
fwd gamepad.BUTTON_SOUTH; fwd gamepad.BUTTON_EAST;
fwd gamepad.BUTTON_WEST; fwd gamepad.BUTTON_NORTH;
fwd gamepad.BUTTON_BACK; fwd gamepad.BUTTON_GUIDE; fwd gamepad.BUTTON_START;
