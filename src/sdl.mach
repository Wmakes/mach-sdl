fwd rand.seed;
fwd rand.rand_int;
fwd rand.rand_f32;
fwd rand.rand_range;
fwd rand.rand_bool;

# --- message box ---
fwd msgbox.KIND_ERROR; fwd msgbox.KIND_WARN; fwd msgbox.KIND_INFO;
fwd msgbox.show;
fwd msgbox.error;
fwd msgbox.warn;
fwd msgbox.info;
