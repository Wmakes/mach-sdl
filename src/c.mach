# raw C-ABI imports of SDL 3.2
#
# every SDL function is a pub ext fun with its C name and C-faithful types,
# transcribed directly from SDL3's own headers (SDL_init.h, SDL_video.h,
# SDL_events.h, SDL_error.h -- release-3.2.0 tag). SDL3's `bool` is a real
# C99 _Bool (1 byte), so every SDL bool-returning function is declared `u8`
# here and unwrapped with `!= 0` in the idiomatic wrapper modules, the same
# way mach-glfw unwraps GLFW's int-based booleans in its own core.mach.
#
# scope: init/quit, window, GL context, keyboard, mouse, timing, audio,
# 2D renderer. gamepad/joystick support was removed. still deferred:
# haptics, camera, sensors.

# --- SDL_init.h ---

pub val INIT_VIDEO:  u32 = 0x00000020;
pub val INIT_AUDIO:  u32 = 0x00000010;
pub val INIT_EVENTS: u32 = 0x00004000;

#[library("sdl")]
pub ext fun SDL_Init(flags: u32) u8;
#[library("sdl")]
pub ext fun SDL_Quit();

# hints -- SDL_SetHint("SDL_VIDEO_DRIVER", "dummy") forces the headless
# video driver, which is what makes real (non-display-free) test blocks
# possible below: no window server needed, but SDL_Init/SDL_CreateWindow/
# SDL_DestroyWindow all genuinely run, not just get skipped.
#[library("sdl")]
pub ext fun SDL_SetHint(name: *u8, value: *u8) u8;

# --- SDL_error.h ---

#[library("sdl")]
pub ext fun SDL_GetError() *u8;

# --- SDL_video.h ---

pub val WINDOW_OPENGL:    u64 = 0x0000000000000002;
pub val WINDOW_RESIZABLE: u64 = 0x0000000000000020;

#[library("sdl")]
pub ext fun SDL_CreateWindow(title: *u8, w: i32, h: i32, flags: u64) ptr;
#[library("sdl")]
pub ext fun SDL_DestroyWindow(window: ptr);

#[library("sdl")]
pub ext fun SDL_GL_CreateContext(window: ptr) ptr;
#[library("sdl")]
pub ext fun SDL_GL_MakeCurrent(window: ptr, context: ptr) u8;
#[library("sdl")]
pub ext fun SDL_GL_SwapWindow(window: ptr) u8;
#[library("sdl")]
pub ext fun SDL_GL_GetProcAddress(proc: *u8) ptr;
#[library("sdl")]
pub ext fun SDL_GL_DestroyContext(context: ptr) u8;

# --- SDL_events.h ---

pub val EVENT_QUIT:     u32 = 0x100;
pub val EVENT_KEY_DOWN: u32 = 0x300;
pub val EVENT_KEY_UP:   u32 = 0x301;

# SDL_Event: a 128-byte tagged union, size fixed by SDL's own
# `Uint8 padding[128]` member (and a compile-time assert on their end that
# sizeof(SDL_Event) == sizeof(padding)) specifically so it's ABI-stable
# across SDL versions. `event_type` is the discriminant; reinterpret the
# same bytes as KeyboardEvent once you've checked it -- same trick
# std.term.windows' InputRecord needed.
pub rec Event {
    event_type: u32;
    _pad:       [124]u8;
}

# SDL_KeyboardEvent, transcribed field-for-field from SDL_events.h. sizes:
# type/reserved u32(4)+u32(4), timestamp Uint64(8), windowID/which
# u32(4)+u32(4), scancode/key u32(4)+u32(4), mod Uint16(2), raw Uint16(2),
# down/repeat bool(1)+bool(1) = 38 bytes, padded to 40 for the Uint64's
# 8-byte alignment requirement.
pub rec KeyboardEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    scancode:   u32;
    key:        u32;
    mod_:       u16;
    raw:        u16;
    down:       u8;
    repeat:     u8;
}

#[library("sdl")]
pub ext fun SDL_PollEvent(event: *Event) u8;

test sdl_c_keyboardevent_layout_is_40_bytes {
    if ($size_of(KeyboardEvent) != 40) { ret 1; }
    ret 0;
}

# --- window events ---

pub val EVENT_WINDOW_RESIZED:         u32 = 0x206;
pub val EVENT_WINDOW_FOCUS_GAINED:    u32 = 0x20E;
pub val EVENT_WINDOW_FOCUS_LOST:      u32 = 0x20F;
pub val EVENT_WINDOW_CLOSE_REQUESTED: u32 = 0x210;

# SDL_WindowEvent, transcribed field-for-field. type/reserved u32+u32(8),
# timestamp u64(8), windowID u32(4), data1/data2 i32+i32(8) = 28 bytes,
# padded to 32 for the embedded u64's 8-byte alignment.
pub rec WindowEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    data1:      i32;
    data2:      i32;
}

test sdl_c_windowevent_layout_is_32_bytes {
    if ($size_of(WindowEvent) != 32) { ret 1; }
    ret 0;
}

# --- SDL_mouse.h ---

pub val BUTTON_LEFT:   u8 = 1;
pub val BUTTON_MIDDLE: u8 = 2;
pub val BUTTON_RIGHT:  u8 = 3;
pub val BUTTON_X1:     u8 = 4;
pub val BUTTON_X2:     u8 = 5;

#[library("sdl")]
pub ext fun SDL_GetMouseState(x: *f32, y: *f32) u32;
#[library("sdl")]
pub ext fun SDL_WarpMouseInWindow(window: ptr, x: f32, y: f32);
#[library("sdl")]
pub ext fun SDL_ShowCursor() u8;
#[library("sdl")]
pub ext fun SDL_HideCursor() u8;

pub val EVENT_MOUSE_MOTION:      u32 = 0x400;
pub val EVENT_MOUSE_BUTTON_DOWN: u32 = 0x401;
pub val EVENT_MOUSE_BUTTON_UP:   u32 = 0x402;
pub val EVENT_MOUSE_WHEEL:       u32 = 0x403;

# SDL_MouseMotionEvent: type/reserved(8), timestamp u64(8), windowID(4),
# which u32(4), state u32(4), x/y/xrel/yrel f32 x4(16) = 44 bytes, padded
# to 48.
pub rec MouseMotionEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    state:      u32;
    x:          f32;
    y:          f32;
    xrel:       f32;
    yrel:       f32;
}

test sdl_c_mousemotionevent_layout_is_48_bytes {
    if ($size_of(MouseMotionEvent) != 48) { ret 1; }
    ret 0;
}

# SDL_MouseButtonEvent: type/reserved(8), timestamp u64(8), windowID(4),
# which u32(4), button/down/clicks/padding u8 x4(4), x/y f32 x2(8) =
# 36 bytes, padded to 40.
pub rec MouseButtonEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    button:     u8;
    down:       u8;
    clicks:     u8;
    _pad:       u8;
    x:          f32;
    y:          f32;
}

test sdl_c_mousebuttonevent_layout_is_40_bytes {
    if ($size_of(MouseButtonEvent) != 40) { ret 1; }
    ret 0;
}

# SDL_MouseWheelEvent: type/reserved(8), timestamp u64(8), windowID(4),
# which u32(4), x/y f32 x2(8), direction i32(4), mouse_x/mouse_y f32 x2(8)
# = 44 bytes, padded to 48.
pub rec MouseWheelEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    x:          f32;
    y:          f32;
    direction:  i32;
    mouse_x:    f32;
    mouse_y:    f32;
}

test sdl_c_mousewheelevent_layout_is_48_bytes {
    if ($size_of(MouseWheelEvent) != 48) { ret 1; }
    ret 0;
}

# --- text input (SDL_keyboard.h / SDL_events.h) ---
#
# text input is disabled by default -- SDL_StartTextInput must be called
# before any EVENT_TEXT_INPUT events appear. SDL_TextInputEvent.text is a
# const char* pointer to an SDL-internal buffer, valid only until the next
# SDL_PollEvent; copy it if you need to keep it.

pub val EVENT_TEXT_INPUT: u32 = 0x303;

pub rec TextInputEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    text:       *u8;
}

test sdl_c_textinputevent_layout_is_32_bytes {
    if ($size_of(TextInputEvent) != 32) { ret 1; }
    ret 0;
}

#[library("sdl")]
pub ext fun SDL_StartTextInput(window: ptr) u8;
#[library("sdl")]
pub ext fun SDL_StopTextInput(window: ptr) u8;

# --- SDL_timer.h ---
#
# no structs here -- every function is a plain scalar in, scalar out, so
# there's nothing to get an ABI layout wrong on.

#[library("sdl")]
pub ext fun SDL_GetTicks() u64;
#[library("sdl")]
pub ext fun SDL_GetTicksNS() u64;
#[library("sdl")]
pub ext fun SDL_GetPerformanceCounter() u64;
#[library("sdl")]
pub ext fun SDL_GetPerformanceFrequency() u64;
#[library("sdl")]
pub ext fun SDL_Delay(ms: u32);

# --- SDL_rect.h ---

# SDL_FRect: 4 f32 fields, no padding -- every offset already 4-aligned
# and the total (16) is a multiple of 4.
pub rec FRect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

test sdl_c_frect_layout_is_16_bytes {
    if ($size_of(FRect) != 16) { ret 1; }
    ret 0;
}

# --- SDL_render.h ---
#
# an alternative to sdl.gl for simple 2D drawing: SDL's own renderer
# (software or hardware-accelerated, SDL picks) instead of hand-loaded GL
# calls. use this OR gl.mach for drawing, not both on the same window --
# SDL_CreateRenderer and SDL_GL_CreateContext both claim the window's
# drawable surface.

#[library("sdl")]
pub ext fun SDL_CreateRenderer(window: ptr, name: *u8) ptr;
#[library("sdl")]
pub ext fun SDL_DestroyRenderer(renderer: ptr);
#[library("sdl")]
pub ext fun SDL_SetRenderDrawColor(renderer: ptr, r: u8, g: u8, b: u8, a: u8) u8;
#[library("sdl")]
pub ext fun SDL_RenderClear(renderer: ptr) u8;
#[library("sdl")]
pub ext fun SDL_RenderFillRect(renderer: ptr, rect: *FRect) u8;
#[library("sdl")]
pub ext fun SDL_RenderRect(renderer: ptr, rect: *FRect) u8;
#[library("sdl")]
pub ext fun SDL_RenderLine(renderer: ptr, x1: f32, y1: f32, x2: f32, y2: f32) u8;
#[library("sdl")]
pub ext fun SDL_RenderPresent(renderer: ptr) u8;

# --- SDL_audio.h ---
#
# minimal playback path: open a stream bound straight to the default
# output device, push raw samples into it, resume (streams start
# paused). no callback-driven playback and no capture/recording. device
# enumeration and WAV loading are bound below (sdl.audio, sdl.wav).

pub val AUDIO_DEVICE_DEFAULT_PLAYBACK: u32 = 0xFFFFFFFF;

# little-endian format tags (SDL_AUDIO_S16LE / SDL_AUDIO_F32LE) -- correct
# for x86_64/aarch64, which are effectively always little-endian in
# practice. computed from SDL_DEFINE_AUDIO_FORMAT's bit-packing, not
# guessed: (signed<<15)|(bigendian<<12)|(float<<8)|bitsize.
pub val AUDIO_FORMAT_U8:  u32 = 0x0008;
pub val AUDIO_FORMAT_S8:  u32 = 0x8008;
pub val AUDIO_FORMAT_S16: u32 = 0x8010;
pub val AUDIO_FORMAT_S32: u32 = 0x8020;
pub val AUDIO_FORMAT_F32: u32 = 0x8120;

# SDL_AudioSpec: format (enum, 4 bytes) + channels (int, 4) + freq (int,
# 4) = 12 bytes, no padding -- every field is 4-byte aligned already and
# the total is a multiple of 4.
pub rec AudioSpec {
    format:   u32;
    channels: i32;
    freq:     i32;
}

test sdl_c_audiospec_layout_is_12_bytes {
    if ($size_of(AudioSpec) != 12) { ret 1; }
    ret 0;
}

# callback param is always nil here (manual push-based playback, not
# callback-driven), so it's typed as a plain ptr rather than a real
# function-pointer type -- there's nothing to reinterpret it as.
#[library("sdl")]
pub ext fun SDL_OpenAudioDeviceStream(devid: u32, spec: *AudioSpec, callback: ptr, userdata: ptr) ptr;
#[library("sdl")]
pub ext fun SDL_PutAudioStreamData(stream: ptr, buf: ptr, len: i32) u8;
#[library("sdl")]
pub ext fun SDL_ResumeAudioStreamDevice(stream: ptr) u8;
#[library("sdl")]
pub ext fun SDL_PauseAudioStreamDevice(stream: ptr) u8;
#[library("sdl")]
pub ext fun SDL_DestroyAudioStream(stream: ptr);

# --- audio stream queries + device enumeration (SDL_audio.h) ---
#
# SDL_GetAudioStreamAvailable returns bytes queued (signed), useful for
# checking if a stream has data ready. SDL_ClearAudioStream discards all
# buffered data. SDL_GetAudioPlaybackDevices returns a heap-allocated
# array of device IDs -- caller must free with SDL_free. SDL_GetAudioDeviceName
# returns a pointer to an internal string (no copy needed, no free needed).

#[library("sdl")]
pub ext fun SDL_GetAudioStreamAvailable(stream: ptr) i32;
#[library("sdl")]
pub ext fun SDL_ClearAudioStream(stream: ptr) u8;
#[library("sdl")]
pub ext fun SDL_GetAudioPlaybackDevices(count: *i32) ptr;
#[library("sdl")]
pub ext fun SDL_GetAudioDeviceName(devid: u32) *u8;

# SDL_LoadWAV reads a WAV file: it fills spec, hands back a heap buffer in
# audio_buf (caller must SDL_free it) and its byte length in audio_len.
#[library("sdl")]
pub ext fun SDL_LoadWAV(path: *u8, spec: *AudioSpec, audio_buf: *ptr, audio_len: *u32) u8;

# --- textures (SDL_surface.h / SDL_render.h) ---
#
# just enough to draw a static image: load a BMP into a surface, upload
# it to a texture, draw the texture, clean up. no procedural surface
# creation, no pixel-level editing, no other image formats (those need
# SDL_image, a separate library not bound here) -- deferred until
# something needs them.

pub val TEXTUREACCESS_STATIC:    i32 = 0;
pub val TEXTUREACCESS_STREAMING: i32 = 1;
pub val TEXTUREACCESS_TARGET:    i32 = 2;

pub val PIXELFORMAT_RGBA8888: u32 = 0x16462004;

#[library("sdl")]
pub ext fun SDL_LoadBMP(file: *u8) ptr;
#[library("sdl")]
pub ext fun SDL_DestroySurface(surface: ptr);
#[library("sdl")]
pub ext fun SDL_CreateTextureFromSurface(renderer: ptr, surface: ptr) ptr;
#[library("sdl")]
pub ext fun SDL_CreateTexture(renderer: ptr, format: u32, access: i32, w: i32, h: i32) ptr;
#[library("sdl")]
pub ext fun SDL_DestroyTexture(texture: ptr);
#[library("sdl")]
pub ext fun SDL_GetTextureSize(texture: ptr, w: *f32, h: *f32) u8;
#[library("sdl")]
pub ext fun SDL_RenderTexture(renderer: ptr, texture: ptr, srcrect: *FRect, dstrect: *FRect) u8;

#[library("sdl")]
pub ext fun SDL_RenderTextureRotated(renderer: ptr, texture: ptr, srcrect: *FRect, dstrect: *FRect, angle: f64, center: *FPoint, flip: u32) u8;

# --- scale mode + flip mode (SDL_surface.h) ---
#
# plain integer enums, not structs -- just named constants.

pub val SCALEMODE_NEAREST: u32 = 0;
pub val SCALEMODE_LINEAR:  u32 = 1;

pub val FLIP_NONE:       u32 = 0;
pub val FLIP_HORIZONTAL: u32 = 1;
pub val FLIP_VERTICAL:   u32 = 2;

# --- texture properties (SDL_render.h) ---
#
# blend mode, color/alpha mod, and scale mode on individual textures.
# these are independent of the renderer-level draw blend mode set by
# set_blend_mode above.

#[library("sdl")]
pub ext fun SDL_SetTextureBlendMode(texture: ptr, blend_mode: u32) u8;
#[library("sdl")]
pub ext fun SDL_GetTextureBlendMode(texture: ptr, blend_mode: *u32) u8;
#[library("sdl")]
pub ext fun SDL_SetTextureColorMod(texture: ptr, r: u8, g: u8, b: u8) u8;
#[library("sdl")]
pub ext fun SDL_GetTextureColorMod(texture: ptr, r: *u8, g: *u8, b: *u8) u8;
#[library("sdl")]
pub ext fun SDL_SetTextureAlphaMod(texture: ptr, alpha: u8) u8;
#[library("sdl")]
pub ext fun SDL_GetTextureAlphaMod(texture: ptr, alpha: *u8) u8;
#[library("sdl")]
pub ext fun SDL_SetTextureScaleMode(texture: ptr, scale_mode: u32) u8;
#[library("sdl")]
pub ext fun SDL_GetTextureScaleMode(texture: ptr, scale_mode: *u32) u8;

# --- more window management (SDL_video.h) ---

#[library("sdl")]
pub ext fun SDL_SetWindowTitle(window: ptr, title: *u8) u8;
#[library("sdl")]
pub ext fun SDL_GetWindowSize(window: ptr, w: *i32, h: *i32) u8;
#[library("sdl")]
pub ext fun SDL_SetWindowSize(window: ptr, w: i32, h: i32) u8;

# --- keyboard state (SDL_keyboard.h) ---
