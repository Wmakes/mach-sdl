# raw C-ABI imports of SDL 3.2
#
# every SDL function is a pub ext fun with its C name and C-faithful types,
# transcribed directly from SDL3's own headers (SDL_init.h, SDL_video.h,
# SDL_events.h, SDL_error.h -- release-3.2.0 tag). SDL3's `bool` is a real
# C99 _Bool (1 byte), so every SDL bool-returning function is declared `u8`
# here and unwrapped with `!= 0` in the idiomatic wrapper modules, the same
# way mach-glfw unwraps GLFW's int-based booleans in its own core.mach.
#
# v2 scope: init/quit, window, GL context, keyboard, mouse, timing, and
# poll-based gamepad state. still deferred: audio, the 2D renderer,
# haptics, camera, sensors, and event-driven (as opposed to polled)
# gamepad button/axis events.

# --- SDL_init.h ---

pub val INIT_VIDEO:  u32 = 0x00000020;
pub val INIT_AUDIO:  u32 = 0x00000010;
pub val INIT_EVENTS: u32 = 0x00004000;

pub ext fun SDL_Init(flags: u32) u8;
pub ext fun SDL_Quit();

# hints -- SDL_SetHint("SDL_VIDEO_DRIVER", "dummy") forces the headless
# video driver, which is what makes real (non-display-free) test blocks
# possible below: no window server needed, but SDL_Init/SDL_CreateWindow/
# SDL_DestroyWindow all genuinely run, not just get skipped.
pub ext fun SDL_SetHint(name: *u8, value: *u8) u8;

# --- SDL_error.h ---

pub ext fun SDL_GetError() *u8;

# --- SDL_video.h ---

pub val WINDOW_OPENGL:    u64 = 0x0000000000000002;
pub val WINDOW_RESIZABLE: u64 = 0x0000000000000020;

pub ext fun SDL_CreateWindow(title: *u8, w: i32, h: i32, flags: u64) ptr;
pub ext fun SDL_DestroyWindow(window: ptr);

pub ext fun SDL_GL_CreateContext(window: ptr) ptr;
pub ext fun SDL_GL_MakeCurrent(window: ptr, context: ptr) u8;
pub ext fun SDL_GL_SwapWindow(window: ptr) u8;
pub ext fun SDL_GL_GetProcAddress(proc: *u8) ptr;
pub ext fun SDL_GL_DestroyContext(context: ptr) u8;

# --- SDL_events.h ---

pub val EVENT_QUIT:     u32 = 0x100;
pub val EVENT_KEY_DOWN: u32 = 0x300;
pub val EVENT_KEY_UP:   u32 = 0x301;

# SDL_Event: a 128-byte tagged union, size fixed by SDL's own
# `Uint8 padding[128]` member (and a compile-time assert on their end that
# sizeof(SDL_Event) == sizeof(padding)) specifically so it's ABI-stable
# across SDL versions. `event_type` is the discriminant; reinterpret the
# same bytes as KeyboardEvent once you've checked it -- same trick
# std.term.windows' InputRecord needed.
pub rec Event {
    event_type: u32;
    _pad:       [124]u8;
}

# SDL_KeyboardEvent, transcribed field-for-field from SDL_events.h. sizes:
# type/reserved u32(4)+u32(4), timestamp Uint64(8), windowID/which
# u32(4)+u32(4), scancode/key u32(4)+u32(4), mod Uint16(2), raw Uint16(2),
# down/repeat bool(1)+bool(1) = 38 bytes, padded to 40 for the Uint64's
# 8-byte alignment requirement.
pub rec KeyboardEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    scancode:   u32;
    key:        u32;
    mod_:       u16;
    raw:        u16;
    down:       u8;
    repeat:     u8;
}

pub ext fun SDL_PollEvent(event: *Event) u8;

test "sdl.c: KeyboardEvent layout is 40 bytes" {
    if ($size_of(KeyboardEvent) != 40) { ret 1; }
    ret 0;
}

# --- window events ---

pub val EVENT_WINDOW_RESIZED:         u32 = 0x206;
pub val EVENT_WINDOW_FOCUS_GAINED:    u32 = 0x20E;
pub val EVENT_WINDOW_FOCUS_LOST:      u32 = 0x20F;
pub val EVENT_WINDOW_CLOSE_REQUESTED: u32 = 0x210;

# SDL_WindowEvent, transcribed field-for-field. type/reserved u32+u32(8),
# timestamp u64(8), windowID u32(4), data1/data2 i32+i32(8) = 28 bytes,
# padded to 32 for the embedded u64's 8-byte alignment.
pub rec WindowEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    data1:      i32;
    data2:      i32;
}

test "sdl.c: WindowEvent layout is 32 bytes" {
    if ($size_of(WindowEvent) != 32) { ret 1; }
    ret 0;
}

# --- SDL_mouse.h ---

pub val BUTTON_LEFT:   u8 = 1;
pub val BUTTON_MIDDLE: u8 = 2;
pub val BUTTON_RIGHT:  u8 = 3;
pub val BUTTON_X1:     u8 = 4;
pub val BUTTON_X2:     u8 = 5;

pub ext fun SDL_GetMouseState(x: *f32, y: *f32) u32;
pub ext fun SDL_WarpMouseInWindow(window: ptr, x: f32, y: f32);
pub ext fun SDL_ShowCursor() u8;
pub ext fun SDL_HideCursor() u8;

pub val EVENT_MOUSE_MOTION:      u32 = 0x400;
pub val EVENT_MOUSE_BUTTON_DOWN: u32 = 0x401;
pub val EVENT_MOUSE_BUTTON_UP:   u32 = 0x402;
pub val EVENT_MOUSE_WHEEL:       u32 = 0x403;

# SDL_MouseMotionEvent: type/reserved(8), timestamp u64(8), windowID(4),
# which u32(4), state u32(4), x/y/xrel/yrel f32 x4(16) = 44 bytes, padded
# to 48.
pub rec MouseMotionEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    state:      u32;
    x:          f32;
    y:          f32;
    xrel:       f32;
    yrel:       f32;
}

test "sdl.c: MouseMotionEvent layout is 48 bytes" {
    if ($size_of(MouseMotionEvent) != 48) { ret 1; }
    ret 0;
}

# SDL_MouseButtonEvent: type/reserved(8), timestamp u64(8), windowID(4),
# which u32(4), button/down/clicks/padding u8 x4(4), x/y f32 x2(8) =
# 36 bytes, padded to 40.
pub rec MouseButtonEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    button:     u8;
    down:       u8;
    clicks:     u8;
    _pad:       u8;
    x:          f32;
    y:          f32;
}

test "sdl.c: MouseButtonEvent layout is 40 bytes" {
    if ($size_of(MouseButtonEvent) != 40) { ret 1; }
    ret 0;
}

# SDL_MouseWheelEvent: type/reserved(8), timestamp u64(8), windowID(4),
# which u32(4), x/y f32 x2(8), direction i32(4), mouse_x/mouse_y f32 x2(8)
# = 44 bytes, padded to 48.
pub rec MouseWheelEvent {
    event_type: u32;
    reserved:   u32;
    timestamp:  u64;
    window_id:  u32;
    which:      u32;
    x:          f32;
    y:          f32;
    direction:  i32;
    mouse_x:    f32;
    mouse_y:    f32;
}

test "sdl.c: MouseWheelEvent layout is 48 bytes" {
    if ($size_of(MouseWheelEvent) != 48) { ret 1; }
    ret 0;
}

# --- SDL_timer.h ---
#
# no structs here -- every function is a plain scalar in, scalar out, so
# there's nothing to get an ABI layout wrong on.

pub ext fun SDL_GetTicks() u64;
pub ext fun SDL_GetTicksNS() u64;
pub ext fun SDL_GetPerformanceCounter() u64;
pub ext fun SDL_GetPerformanceFrequency() u64;
pub ext fun SDL_Delay(ms: u32);

# --- SDL_gamepad.h / SDL_joystick.h ---
#
# poll-based only: open a gamepad, ask it for button/axis state each
# frame. no event-driven gamepad handling (button-down/up/connect events)
# yet -- deferred, same reasoning as everywhere else in this file: add it
# when something actually needs it.

pub ext fun SDL_HasGamepad() u8;
pub ext fun SDL_GetGamepads(count: *i32) ptr;
pub ext fun SDL_OpenGamepad(instance_id: u32) ptr;
pub ext fun SDL_CloseGamepad(gamepad: ptr);
pub ext fun SDL_GetGamepadButton(gamepad: ptr, button: i32) u8;
pub ext fun SDL_GetGamepadAxis(gamepad: ptr, axis: i32) i16;

pub val GAMEPAD_BUTTON_SOUTH:          i32 = 0;
pub val GAMEPAD_BUTTON_EAST:           i32 = 1;
pub val GAMEPAD_BUTTON_WEST:           i32 = 2;
pub val GAMEPAD_BUTTON_NORTH:          i32 = 3;
pub val GAMEPAD_BUTTON_BACK:           i32 = 4;
pub val GAMEPAD_BUTTON_GUIDE:          i32 = 5;
pub val GAMEPAD_BUTTON_START:          i32 = 6;
pub val GAMEPAD_BUTTON_LEFT_STICK:     i32 = 7;
pub val GAMEPAD_BUTTON_RIGHT_STICK:    i32 = 8;
pub val GAMEPAD_BUTTON_LEFT_SHOULDER:  i32 = 9;
pub val GAMEPAD_BUTTON_RIGHT_SHOULDER: i32 = 10;
pub val GAMEPAD_BUTTON_DPAD_UP:        i32 = 11;
pub val GAMEPAD_BUTTON_DPAD_DOWN:      i32 = 12;
pub val GAMEPAD_BUTTON_DPAD_LEFT:      i32 = 13;
pub val GAMEPAD_BUTTON_DPAD_RIGHT:     i32 = 14;

pub val GAMEPAD_AXIS_LEFTX:         i32 = 0;
pub val GAMEPAD_AXIS_LEFTY:         i32 = 1;
pub val GAMEPAD_AXIS_RIGHTX:        i32 = 2;
pub val GAMEPAD_AXIS_RIGHTY:        i32 = 3;
pub val GAMEPAD_AXIS_LEFT_TRIGGER:  i32 = 4;
pub val GAMEPAD_AXIS_RIGHT_TRIGGER: i32 = 5;

# --- SDL_rect.h ---

# SDL_FRect: 4 f32 fields, no padding -- every offset already 4-aligned
# and the total (16) is a multiple of 4.
pub rec FRect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

test "sdl.c: FRect layout is 16 bytes" {
    if ($size_of(FRect) != 16) { ret 1; }
    ret 0;
}

# --- SDL_render.h ---
#
# an alternative to sdl.gl for simple 2D drawing: SDL's own renderer
# (software or hardware-accelerated, SDL picks) instead of hand-loaded GL
# calls. use this OR gl.mach for drawing, not both on the same window --
# SDL_CreateRenderer and SDL_GL_CreateContext both claim the window's
# drawable surface.

pub ext fun SDL_CreateRenderer(window: ptr, name: *u8) ptr;
pub ext fun SDL_DestroyRenderer(renderer: ptr);
pub ext fun SDL_SetRenderDrawColor(renderer: ptr, r: u8, g: u8, b: u8, a: u8) u8;
pub ext fun SDL_RenderClear(renderer: ptr) u8;
pub ext fun SDL_RenderFillRect(renderer: ptr, rect: *FRect) u8;
pub ext fun SDL_RenderRect(renderer: ptr, rect: *FRect) u8;
pub ext fun SDL_RenderLine(renderer: ptr, x1: f32, y1: f32, x2: f32, y2: f32) u8;
pub ext fun SDL_RenderPresent(renderer: ptr) u8;

# --- SDL_audio.h ---
#
# minimal playback path: open a stream bound straight to the default
# output device, push raw samples into it, resume (streams start
# paused). no callback-driven playback, no capture/recording, no
# multi-device enumeration -- deferred until something needs them.

pub val AUDIO_DEVICE_DEFAULT_PLAYBACK: u32 = 0xFFFFFFFF;

# little-endian format tags (SDL_AUDIO_S16LE / SDL_AUDIO_F32LE) -- correct
# for x86_64/aarch64, which are effectively always little-endian in
# practice. computed from SDL_DEFINE_AUDIO_FORMAT's bit-packing, not
# guessed: (signed<<15)|(bigendian<<12)|(float<<8)|bitsize.
pub val AUDIO_FORMAT_S16: u32 = 0x8010;
pub val AUDIO_FORMAT_F32: u32 = 0x8120;

# SDL_AudioSpec: format (enum, 4 bytes) + channels (int, 4) + freq (int,
# 4) = 12 bytes, no padding -- every field is 4-byte aligned already and
# the total is a multiple of 4.
pub rec AudioSpec {
    format:   u32;
    channels: i32;
    freq:     i32;
}

test "sdl.c: AudioSpec layout is 12 bytes" {
    if ($size_of(AudioSpec) != 12) { ret 1; }
    ret 0;
}

# callback param is always nil here (manual push-based playback, not
# callback-driven), so it's typed as a plain ptr rather than a real
# function-pointer type -- there's nothing to reinterpret it as.
pub ext fun SDL_OpenAudioDeviceStream(devid: u32, spec: *AudioSpec, callback: ptr, userdata: ptr) ptr;
pub ext fun SDL_PutAudioStreamData(stream: ptr, buf: ptr, len: i32) u8;
pub ext fun SDL_ResumeAudioStreamDevice(stream: ptr) u8;
pub ext fun SDL_PauseAudioStreamDevice(stream: ptr) u8;
pub ext fun SDL_DestroyAudioStream(stream: ptr);

# --- textures (SDL_surface.h / SDL_render.h) ---
#
# just enough to draw a static image: load a BMP into a surface, upload
# it to a texture, draw the texture, clean up. no procedural surface
# creation, no pixel-level editing, no other image formats (those need
# SDL_image, a separate library not bound here) -- deferred until
# something needs them.

pub ext fun SDL_LoadBMP(file: *u8) ptr;
pub ext fun SDL_DestroySurface(surface: ptr);
pub ext fun SDL_CreateTextureFromSurface(renderer: ptr, surface: ptr) ptr;
pub ext fun SDL_DestroyTexture(texture: ptr);
pub ext fun SDL_GetTextureSize(texture: ptr, w: *f32, h: *f32) u8;
pub ext fun SDL_RenderTexture(renderer: ptr, texture: ptr, srcrect: *FRect, dstrect: *FRect) u8;

# --- more window management (SDL_video.h) ---

pub ext fun SDL_SetWindowTitle(window: ptr, title: *u8) u8;
pub ext fun SDL_GetWindowSize(window: ptr, w: *i32, h: *i32) u8;
pub ext fun SDL_SetWindowPosition(window: ptr, x: i32, y: i32) u8;
pub ext fun SDL_SetWindowFullscreen(window: ptr, fullscreen: u8) u8;

# --- gamepad rumble (SDL_gamepad.h) ---

pub ext fun SDL_RumbleGamepad(gamepad: ptr, low_freq: u16, high_freq: u16, duration_ms: u32) u8;

# --- rect intersection (SDL_rect.h) ---
#
# SDL_PointInRectFloat is NOT bound -- it's SDL_FORCE_INLINE in the
# header, never actually exported from the compiled library, so there's
# no symbol to ext-fun against. Reimplemented directly in rect.mach
# instead (it's simple comparison logic, not worth an FFI call anyway).

pub ext fun SDL_HasRectIntersectionFloat(a: *FRect, b: *FRect) u8;
pub ext fun SDL_GetRectIntersectionFloat(a: *FRect, b: *FRect, result: *FRect) u8;

# --- random (SDL_stdinc.h) ---

pub ext fun SDL_srand(seed: u64);
pub ext fun SDL_rand(n: i32) i32;
pub ext fun SDL_randf() f32;

# --- message box (SDL_messagebox.h) ---

pub val MESSAGEBOX_ERROR:       u32 = 0x00000010;
pub val MESSAGEBOX_WARNING:     u32 = 0x00000020;
pub val MESSAGEBOX_INFORMATION: u32 = 0x00000040;

pub ext fun SDL_ShowSimpleMessageBox(flags: u32, title: *u8, message: *u8, window: ptr) u8;

# --- blend modes (SDL_blendmode.h) ---
#
# SDL_BlendMode is a plain Uint32 flag/enum, not a struct -- these are
# just named constants, same shape as the MESSAGEBOX_* block above.
# values confirmed against the real header, release-3.2.0.

pub val BLENDMODE_NONE:                u32 = 0x00000000;
pub val BLENDMODE_BLEND:               u32 = 0x00000001;
pub val BLENDMODE_BLEND_PREMULTIPLIED: u32 = 0x00000010;
pub val BLENDMODE_ADD:                 u32 = 0x00000002;
pub val BLENDMODE_ADD_PREMULTIPLIED:   u32 = 0x00000020;
pub val BLENDMODE_MOD:                 u32 = 0x00000004;
pub val BLENDMODE_MUL:                 u32 = 0x00000008;

pub ext fun SDL_SetRenderDrawBlendMode(renderer: ptr, blend_mode: u32) u8;

# --- render target (SDL_render.h) ---
#
# nil restores the window itself as the target.
#
# KNOWN GAP: a texture passed here must have been created with
# render-target access (SDL_CreateTexture + SDL_TEXTUREACCESS_TARGET on
# the C side). This binding only creates textures via
# renderer.load_texture (SDL_LoadBMP + SDL_CreateTextureFromSurface),
# which does NOT grant render-target access -- a lower-level
# SDL_CreateTexture binding would be needed before render-to-texture is
# actually usable here. flagging rather than assuming it works.

pub ext fun SDL_SetRenderTarget(renderer: ptr, texture: ptr) u8;

# --- clip rect (SDL_rect.h / SDL_render.h) ---
#
# unlike everything else in this renderer surface, SDL's clip-rect calls
# use the *integer* SDL_Rect, not SDL_FRect -- transcribed separately.
# SDL_Rect: 4 int fields (x, y, w, h), no padding -- every offset already
# 4-aligned and the total (16) is a multiple of 4.
pub rec Rect {
    x: i32;
    y: i32;
    w: i32;
    h: i32;
}

test "sdl.c: Rect layout is 16 bytes" {
    if ($size_of(Rect) != 16) { ret 1; }
    ret 0;
}

pub ext fun SDL_SetRenderClipRect(renderer: ptr, rect: *Rect) u8;
pub ext fun SDL_GetRenderClipRect(renderer: ptr, rect: *Rect) u8;

# --- render scale (SDL_render.h) ---

pub ext fun SDL_SetRenderScale(renderer: ptr, scale_x: f32, scale_y: f32) u8;
pub ext fun SDL_GetRenderScale(renderer: ptr, scale_x: *f32, scale_y: *f32) u8;

# --- bulk draws (SDL_render.h) ---
#
# SDL_FPoint: 2 f32 fields, no padding -- same reasoning as FRect above
# (every offset already 4-aligned, total already a multiple of 4).
pub rec FPoint {
    x: f32;
    y: f32;
}

test "sdl.c: FPoint layout is 8 bytes" {
    if ($size_of(FPoint) != 8) { ret 1; }
    ret 0;
}

pub ext fun SDL_RenderPoints(renderer: ptr, points: ptr, count: i32) u8;
pub ext fun SDL_RenderLines(renderer: ptr, points: ptr, count: i32) u8;
pub ext fun SDL_RenderFillRects(renderer: ptr, rects: ptr, count: i32) u8;

# --- clipboard (SDL_clipboard.h) ---
#
# SDL_GetClipboardText allocates a fresh buffer on every call (unlike
# SDL_GetError's reused thread-local buffer) -- the caller owns it and
# must free it with SDL_free. Returns an empty string (never nil) on
# failure too. See clipboard.mach's get_text/free_text.

pub ext fun SDL_SetClipboardText(text: *u8) u8;
pub ext fun SDL_GetClipboardText() *u8;
pub ext fun SDL_HasClipboardText() u8;

# --- memory (SDL_stdinc.h) ---
#
# needed specifically to free SDL-owned heap allocations this binding
# receives: the gamepad-ID array from SDL_GetGamepads (gamepad.mach's
# open_first_gamepad -- previously a known leak, now fixed by calling
# this) and the string from SDL_GetClipboardText (clipboard.mach's
# free_text).

pub ext fun SDL_free(mem: ptr);

# --- mouse relative mode + capture (SDL_mouse.h) ---

pub ext fun SDL_SetWindowRelativeMouseMode(window: ptr, enabled: u8) u8;
pub ext fun SDL_GetWindowRelativeMouseMode(window: ptr) u8;
pub ext fun SDL_GetRelativeMouseState(x: *f32, y: *f32) u32;
pub ext fun SDL_CaptureMouse(enabled: u8) u8;

# --- window minimize/maximize/restore/raise + min/max size (SDL_video.h) ---

pub ext fun SDL_MinimizeWindow(window: ptr) u8;
pub ext fun SDL_MaximizeWindow(window: ptr) u8;
pub ext fun SDL_RestoreWindow(window: ptr) u8;
pub ext fun SDL_RaiseWindow(window: ptr) u8;
pub ext fun SDL_SetWindowMinimumSize(window: ptr, min_w: i32, min_h: i32) u8;
pub ext fun SDL_SetWindowMaximumSize(window: ptr, max_w: i32, max_h: i32) u8;
