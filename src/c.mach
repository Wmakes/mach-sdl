#[library("sdl")]
pub ext fun SDL_SetWindowFullscreen(window: ptr, fullscreen: u8) u8;

# --- rect intersection (SDL_rect.h) ---
#
# SDL_PointInRectFloat is NOT bound -- it's SDL_FORCE_INLINE in the
# header, never actually exported from the compiled library, so there's
# no symbol to ext-fun against. Reimplemented directly in rect.mach
# instead (it's simple comparison logic, not worth an FFI call anyway).

#[library("sdl")]
pub ext fun SDL_HasRectIntersectionFloat(a: *FRect, b: *FRect) u8;
#[library("sdl")]
pub ext fun SDL_GetRectIntersectionFloat(a: *FRect, b: *FRect, result: *FRect) u8;

# --- random (SDL_stdinc.h) ---

#[library("sdl")]
pub ext fun SDL_srand(seed: u64);
#[library("sdl")]
pub ext fun SDL_rand(n: i32) i32;
#[library("sdl")]
pub ext fun SDL_randf() f32;

# --- message box (SDL_messagebox.h) ---

pub val MESSAGEBOX_ERROR:       u32 = 0x00000010;
pub val MESSAGEBOX_WARNING:     u32 = 0x00000020;
pub val MESSAGEBOX_INFORMATION: u32 = 0x00000040;

#[library("sdl")]
pub ext fun SDL_ShowSimpleMessageBox(flags: u32, title: *u8, message: *u8, window: ptr) u8;

# --- blend modes (SDL_blendmode.h) ---
#
# SDL_BlendMode is a plain Uint32 flag/enum, not a struct -- these are
# just named constants, same shape as the MESSAGEBOX_* block above.
# values confirmed against the real header, release-3.2.0.

pub val BLENDMODE_NONE:                u32 = 0x00000000;
pub val BLENDMODE_BLEND:               u32 = 0x00000001;
pub val BLENDMODE_BLEND_PREMULTIPLIED: u32 = 0x00000010;
pub val BLENDMODE_ADD:                 u32 = 0x00000002;
pub val BLENDMODE_ADD_PREMULTIPLIED:   u32 = 0x00000020;
pub val BLENDMODE_MOD:                 u32 = 0x00000004;
pub val BLENDMODE_MUL:                 u32 = 0x00000008;

#[library("sdl")]
pub ext fun SDL_SetRenderDrawBlendMode(renderer: ptr, blend_mode: u32) u8;

# --- render target (SDL_render.h) ---
#
# nil restores the window itself as the target.
#
# a texture passed here must have been created with render-target access
# (SDL_CreateTexture + TEXTUREACCESS_TARGET). sdl.texture.create does that.

#[library("sdl")]
pub ext fun SDL_SetRenderTarget(renderer: ptr, texture: ptr) u8;

# --- clip rect (SDL_rect.h / SDL_render.h) ---
#
# unlike everything else in this renderer surface, SDL's clip-rect calls
# use the *integer* SDL_Rect, not SDL_FRect -- transcribed separately.
# SDL_Rect: 4 int fields (x, y, w, h), no padding -- every offset already
# 4-aligned and the total (16) is a multiple of 4.
pub rec Rect {
    x: i32;
    y: i32;
    w: i32;
    h: i32;
}

test sdl_c_rect_layout_is_16_bytes {
    if ($size_of(Rect) != 16) { ret 1; }
    ret 0;
}

#[library("sdl")]
pub ext fun SDL_SetRenderClipRect(renderer: ptr, rect: *Rect) u8;
#[library("sdl")]
pub ext fun SDL_GetRenderClipRect(renderer: ptr, rect: *Rect) u8;

# --- render scale (SDL_render.h) ---

#[library("sdl")]
pub ext fun SDL_SetRenderScale(renderer: ptr, scale_x: f32, scale_y: f32) u8;
#[library("sdl")]
pub ext fun SDL_GetRenderScale(renderer: ptr, scale_x: *f32, scale_y: *f32) u8;

# --- bulk draws (SDL_render.h) ---
#
# SDL_FPoint: 2 f32 fields, no padding -- same reasoning as FRect above
# (every offset already 4-aligned, total already a multiple of 4).
pub rec FPoint {
    x: f32;
    y: f32;
}

test sdl_c_fpoint_layout_is_8_bytes {
    if ($size_of(FPoint) != 8) { ret 1; }
    ret 0;
}

#[library("sdl")]
pub ext fun SDL_RenderPoints(renderer: ptr, points: ptr, count: i32) u8;
#[library("sdl")]
pub ext fun SDL_RenderLines(renderer: ptr, points: ptr, count: i32) u8;
#[library("sdl")]
pub ext fun SDL_RenderFillRects(renderer: ptr, rects: ptr, count: i32) u8;

# --- clipboard (SDL_clipboard.h) ---
#
# SDL_GetClipboardText allocates a fresh buffer on every call (unlike
# SDL_GetError's reused thread-local buffer) -- the caller owns it and
# must free it with SDL_free. Returns an empty string (never nil) on
# failure too. See clipboard.mach's get_text/free_text.

#[library("sdl")]
pub ext fun SDL_SetClipboardText(text: *u8) u8;
#[library("sdl")]
pub ext fun SDL_GetClipboardText() *u8;
#[library("sdl")]
pub ext fun SDL_HasClipboardText() u8;

# --- memory (SDL_stdinc.h) ---
#
# needed to free the string from SDL_GetClipboardText (clipboard.mach's
# free_text).

#[library("sdl")]
pub ext fun SDL_free(mem: ptr);

