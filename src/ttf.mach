# raw SDL3_ttf functions (sdl.ttf)
#
# the C functions of SDL3_ttf under their C names, for anything sdl.font
# does not wrap. prefer sdl.font. C `bool` is u8 here (nonzero is true),
# `const char *` is *u8, a TTF_Font is a ptr (font.Font.handle), and
# SDL_Color arguments are a u32 packed as r | g << 8 | b << 16 | a << 24.
# a text `length` of 0 means the string is NUL-terminated.

use std.types.size.usize;

# --- init / version ---

#[library("sdl-ttf")]
pub ext fun TTF_Version() i32;
#[library("sdl-ttf")]
pub ext fun TTF_Init() u8;
#[library("sdl-ttf")]
pub ext fun TTF_Quit();
#[library("sdl-ttf")]
pub ext fun TTF_WasInit() i32;

# --- font lifetime ---

#[library("sdl-ttf")]
pub ext fun TTF_OpenFont(file: *u8, ptsize: f32) ptr;
#[library("sdl-ttf")]
pub ext fun TTF_CloseFont(font: ptr);

# --- style flags (TTF_FontStyleFlags, a Uint32 bit set) ---

pub val STYLE_NORMAL:        u32 = 0x00;
pub val STYLE_BOLD:          u32 = 0x01;
pub val STYLE_ITALIC:        u32 = 0x02;
pub val STYLE_UNDERLINE:     u32 = 0x04;
pub val STYLE_STRIKETHROUGH: u32 = 0x08;

# --- hinting (TTF_HintingFlags, a plain C enum, int-sized) ---

pub val HINTING_NORMAL:         i32 = 0;
pub val HINTING_LIGHT:          i32 = 1;
pub val HINTING_MONO:           i32 = 2;
pub val HINTING_NONE:           i32 = 3;
pub val HINTING_LIGHT_SUBPIXEL: i32 = 4;

# --- font properties ---

#[library("sdl-ttf")]
pub ext fun TTF_SetFontSize(font: ptr, ptsize: f32) u8;
#[library("sdl-ttf")]
pub ext fun TTF_GetFontSize(font: ptr) f32;
#[library("sdl-ttf")]
pub ext fun TTF_SetFontStyle(font: ptr, style: u32);
#[library("sdl-ttf")]
pub ext fun TTF_GetFontStyle(font: ptr) u32;
#[library("sdl-ttf")]
pub ext fun TTF_SetFontOutline(font: ptr, outline: i32) u8;
#[library("sdl-ttf")]
pub ext fun TTF_GetFontOutline(font: ptr) i32;
#[library("sdl-ttf")]
pub ext fun TTF_SetFontHinting(font: ptr, hinting: i32);
#[library("sdl-ttf")]
pub ext fun TTF_GetFontHinting(font: ptr) i32;
#[library("sdl-ttf")]
pub ext fun TTF_SetFontKerning(font: ptr, enabled: u8);
#[library("sdl-ttf")]
pub ext fun TTF_GetFontKerning(font: ptr) u8;
#[library("sdl-ttf")]
pub ext fun TTF_FontIsFixedWidth(font: ptr) u8;

# the family and style names are font-owned and borrowed; NULL if absent
#[library("sdl-ttf")]
pub ext fun TTF_GetFontFamilyName(font: ptr) *u8;
#[library("sdl-ttf")]
pub ext fun TTF_GetFontStyleName(font: ptr) *u8;

# --- font metrics, in pixels ---

#[library("sdl-ttf")]
pub ext fun TTF_GetFontHeight(font: ptr) i32;
#[library("sdl-ttf")]
pub ext fun TTF_GetFontAscent(font: ptr) i32;
#[library("sdl-ttf")]
pub ext fun TTF_GetFontDescent(font: ptr) i32;
#[library("sdl-ttf")]
pub ext fun TTF_GetFontLineSkip(font: ptr) i32;

# --- measuring text ---

#[library("sdl-ttf")]
pub ext fun TTF_GetStringSize(font: ptr, text: *u8, length: usize, w: *i32, h: *i32) u8;
#[library("sdl-ttf")]
pub ext fun TTF_GetStringSizeWrapped(font: ptr, text: *u8, length: usize, wrap_width: i32, w: *i32, h: *i32) u8;

# --- rendering text to an SDL_Surface (caller owns it: SDL_DestroySurface) ---
#
# solid:   8-bit palettized, fastest, hard edges, no antialiasing
# shaded:  8-bit palettized, antialiased against a solid background color
# blended: 32-bit ARGB, antialiased with real alpha, the usual choice
#
# each returns NULL on failure. empty text also fails in SDL3_ttf, so the
# idiomatic layer reports it as error.Error.failed like any other failure.
# SDL_Color arguments are u32, see the header comment.

#[library("sdl-ttf")]
pub ext fun TTF_RenderText_Solid(font: ptr, text: *u8, length: usize, fg: u32) ptr;
#[library("sdl-ttf")]
pub ext fun TTF_RenderText_Shaded(font: ptr, text: *u8, length: usize, fg: u32, bg: u32) ptr;
#[library("sdl-ttf")]
pub ext fun TTF_RenderText_Blended(font: ptr, text: *u8, length: usize, fg: u32) ptr;
#[library("sdl-ttf")]
pub ext fun TTF_RenderText_Blended_Wrapped(font: ptr, text: *u8, length: usize, fg: u32, wrap_width: i32) ptr;
